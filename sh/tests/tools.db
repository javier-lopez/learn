test X"$(pianocat -s 2>&1|head -1)"      = X"Option '-s' requires a parameter"
test X"$(pianocat -d 2>&1|head -1)"      = X"Option '-d' requires a parameter"
test X"$(pianocat -c 2>&1|head -1)"      = X"Option '-c' requires a parameter"
