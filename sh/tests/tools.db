vim-show -h ; test X"${?}"                             = X"0"
printf "%s" '-h' | vim-show; test X"${?}"              = X"0"
vim-show --help ; test X"${?}"                         = X"0"
printf "%s" '--help' | vim-show; test X"${?}"          = X"0"
vim-show --cui; test X"${?}"                           = X"1"
printf "%s" '--cui'  | vim-show; test X"${?}"          = X"1"
test X"$(vim-show | head -1)"                          = X""
test X"$(vim-show 2>&1 | head -1)"                     = X"Usage: vim-show script"
test X"$(vim-show -h | head -1)"                       = X"Usage: vim-show script"
test X"$(printf "%s" '--help' | vim-show | head -1)"   = X"Usage: vim-show script"
test X"$(vim-show --cui | head -1)"                    = X""
test X"$(vim-show --cui 2>&1|head -1)"                 = X"vim-show: unrecognized option '--cui'"
test X"$(printf "%s" '--cui' | vim-show 2>&1|head -1)" = X"vim-show: unrecognized option '--cui'"
test X"$(vim-show cui 2>&1|head -1)"                   = X"vim-show: 'cui' was not found in \$PATH"
test X"$(printf "%s" 'cui' | vim-show 2>&1|head -1)"   = X"vim-show: 'cui' was not found in \$PATH"
@end

@begin{wcd}
HOME="$(pwd)"; export HOME
WCDHOME="${HOME}/.wcd"; export WCDHOME
mkdir -p proyecto.com otro/deep/proyecto node_modules/x
printf "%s\n" '*/node_modules' '#a comment is not a pattern' > .ban.wcd
wcd --help >/dev/null; test X"${?}"                    = X"0"
wcd --bogus 2>/dev/null; test X"${?}"                  = X"1"
test X"$(wcd --help | head -1)" = X"Usage: wcd [--update|--cron|--no-cron|--prune-aliases]"
wcd --update >/dev/null; test -s "${WCDHOME}/.treedata.wcd"
test X"$(grep -c 'node_modules' "${WCDHOME}/.treedata.wcd")"        = X"0"
test X"$(grep -c '/otro/deep/proyecto$' "${WCDHOME}/.treedata.wcd")" = X"1"
test X"$(grep -c '/proyecto.com$' "${WCDHOME}/.treedata.wcd")"       = X"1"
printf "%s\n" "gone ${HOME}/nothing-here" > "${WCDHOME}/.alias.wcd"
wcd --prune-aliases >/dev/null 2>&1; test X"$(wc -l < "${WCDHOME}/.alias.wcd")" = X"0"
printf "%s\n" "live ${HOME}/proyecto.com" > "${WCDHOME}/.alias.wcd"
test X"$(wcd --prune-aliases)" = X"every alias still points at a directory, nothing to prune"
#the crontab half, against a crontab that is a file in this sandbox: the code
#under test rewrites a real user's crontab, and a test that needed the real one
#to prove it would be the last test anyone ran here
mkdir -p fakebin
printf "%s\n" '#!/bin/sh' 'F="$(dirname "$0")/../fake.crontab"' 'case "$1" in -l) [ -f "$F" ] || exit 1; cat "$F" ;; -) cat > "$F" ;; *) exit 2 ;; esac' > fakebin/crontab
chmod +x fakebin/crontab
PATH="$(pwd)/fakebin:${PATH}"; export PATH
printf "%s\n" "0 7 * * * /usr/bin/something-of-the-users" > fake.crontab
wcd --cron >/dev/null; test X"$(grep -c 'wcd --update' fake.crontab)"    = X"1"
wcd --cron >/dev/null; test X"$(grep -c 'wcd --update' fake.crontab)"    = X"1"
test X"$(wcd --cron)" = X"wcd is already in your crontab, nothing to do"
wcd --no-cron >/dev/null; test X"$(grep -c 'wcd --update' fake.crontab)" = X"0"
test X"$(grep -c 'something-of-the-users' fake.crontab)"                 = X"1"
test -f "${WCDHOME}/.nocron"
#and the half that matters, the one that is sourced. It needs a shell whose "."
#passes arguments through and this runner is /bin/sh, which is dash here, so it
#is asked for by name and the rest is skipped where there is none
command -v bash >/dev/null 2>&1 || exit 0
test X"$(bash -c '. ../../tools/wcd otro >/dev/null 2>&1; pwd')"        = X"${HOME}/otro"
test X"$(bash -c '. ../../tools/wcd proyecto >/dev/null 2>&1; pwd')"    = X"${HOME}/otro/deep/proyecto"
test X"$(bash -c '. ../../tools/wcd proyecto.c >/dev/null 2>&1; pwd')"  = X"${HOME}/proyecto.com"
test X"$(bash -c '. ../../tools/wcd nothing-like-this >/dev/null 2>&1; pwd')" = X"${HOME}"
test X"$(bash -c '. ../../tools/wcd nothing-like-this >/dev/null 2>&1')" = X""
bash -c '. ../../tools/wcd nothing-like-this >/dev/null 2>&1'; test X"${?}" = X"1"
rm -f "${WCDHOME}/.alias.wcd"
bash -c '. ../../tools/wcd proyecto "${HOME}/proyecto.com" >/dev/null 2>&1'
test X"$(cat "${WCDHOME}/.alias.wcd")"                                 = X"proyecto ${HOME}/proyecto.com"
test X"$(bash -c '. ../../tools/wcd proyecto >/dev/null 2>&1; pwd')"    = X"${HOME}/proyecto.com"
test X"$(bash -c 'set -- a b c; . ../../tools/wcd otro >/dev/null 2>&1; echo "$*"')" = X"a b c"
#"-" has to be read before the pattern that rejects unknown options, or the
#most used argument cd has becomes an error message
test X"$(bash -c '. ../../tools/wcd otro >/dev/null 2>&1; . ../../tools/wcd proyecto.com >/dev/null 2>&1; . ../../tools/wcd - >/dev/null 2>&1; pwd')" = X"${HOME}/otro"
bash -c '. ../../tools/wcd --nonsense >/dev/null 2>&1'; test X"${?}" = X"1"
@end

@begin{wget-finder}
wget-finder; test X"${?}"                     = X"1"
wget-finder  -h; test X"${?}"                 = X"0"
printf "%s" '-h' | wget-finder; test X"${?}"  = X"0"
wget-finder --help; test X"${?}"              = X"0"
wget-finder --cui; test X"${?}"               = X"2"
wget-finder --search-engine cui; test X"${?}" = X"1"
wget-finder cui; test X"${?}"                 = X"4"
wget-finder libssh2-1.3.0.tar.gz:cui; test X"${?}" = X"1"
test X"$(wget-finder | head -1)"              = X""
test X"$(wget-finder 2>&1 | head -1)"         = X"Usage: wget-finder [OPTION]... FILE:CHECKSUM..."
test X"$(wget-finder -h | head -1)"           = X"Usage: wget-finder [OPTION]... FILE:CHECKSUM..."
test X"$(printf "%s" '--help' | wget-finder | head -1)" = X"Usage: wget-finder [OPTION]... FILE:CHECKSUM..."
test X"$(wget-finder --cui 2>&1|head -1)"     = X"wget: unrecognized option '--cui'"
test X"$(wget-finder --search-engine cui | head -1)"    = X""
test X"$(wget-finder --search-engine cui 2>&1|head -1)" = X"wget-finder: 'cui' is not a recognized search engine"
wget-finder libssh2-1.3.0.tar.gz:cui; test X"${?}" = X"1"

#an engine defined in the environment is listed, accepted and queried, with
#%s standing in for the file. This is the part that has to keep working when
#every built-in engine has stopped answering, so it is tested without a network
WGET_FINDER_ENGINES='zz=http://127.0.0.1:9/?q=%s' wget-finder --list-search-engine | grep -qx "zz"
wget-finder --list-search-engine | grep -qx "zz"; test X"${?}" = X"1"
WGET_FINDER_ENGINES='zz=http://127.0.0.1:9/?q=%s' wget-finder --search-engine zz --list-links libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709; test X"${?}" = X"1"
wget-finder --search-engine zz --list-links libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709 2>&1 | grep -q "not a recognized search engine"
wget-finder --list-search-engine | grep -qx "brave"
wget-finder --list-search-engine | grep -qx "mmnt"

#%s becomes the file being looked for. Asserted against a wget of our own that
#records what it was asked for, so the claim is about the url that goes out
#and not about whether some website answered it
printf "#!/bin/sh\\nprintf \"%%s\\\\n\" \"\${*}\" >> asked.txt\\n" > wget && chmod +x wget
PATH=".:${PATH}" WGET_FINDER_ENGINES='zz=http://engine.invalid/?q=%s' wget-finder --search-engine zz --list-links zlib-1.3.tar.gz:00000000000000000000000000000000 >/dev/null 2>&1; :
grep -q "q=zlib-1.3.tar.gz" asked.txt
grep -q "q=%s" asked.txt; test X"${?}" = X"1"
rm -f wget asked.txt

#and the live half, which depends on companies this repository does not own.
#A search engine that stops answering is not a defect in wget-finder, so these
#report rather than fail: the assertion is that SOME engine still finds links,
#and each one is still exercised so a crash in an extractor is caught
#one line per statement: the runner appends '|| exit 1' to every line it reads,
#which turns any multi-line shell construct into a syntax error
for e in $(wget-finder --list-search-engine); do n="$(wget-finder --search-engine "${e}" --list-links zlib-1.3.tar.gz:00000000000000000000000000000000 2>/dev/null | wc -l)"; printf "%s: %s links\\n" "${e}" "${n}" >&2; [ "${n}" -gt "0" ] && alive="${alive} ${e}"; done; :
[ -n "${alive}" ] || printf "%s\\n" "warning: no search engine returned links" >&2; :

test X"$(wget-finder libssh2-1.3.0.tar.gz:cui  | head -1)" = X""
test X"$(wget-finder libssh2-1.3.0.tar.gz:cui 2>&1 | head -1)" = X"Warning: 'libssh2-1.3.0.tar.gz:cui' is an invalid FILE:CHECKSUM pair, skipping..."
wget-finder libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709; test -f "libssh2-1.3.0.tar.gz" || :
test X"$(openssl dgst -md5 libssh2-1.3.0.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
rm -rf libssh2-1.3.0.tar.gz
wget-finder libssh2-1.3.0.tar.gz:d342e06abe38a29b1bbb9c58d50dd093eab0bee9 && test -f "libssh2-1.3.0.tar.gz" || :
test X"$(openssl dgst -md5 libssh2-1.3.0.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
rm -rf libssh2-1.3.0.tar.gz
wget-finder libssh2-1.3.0.tar.gz:9de377854202f033bfb57ce4f95194a2b1283d45fb243b5e7dca30e058f40f9c && test -f "libssh2-1.3.0.tar.gz" || :
test X"$(openssl dgst -md5 libssh2-1.3.0.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
rm -rf libssh2-1.3.0.tar.gz
wget-finder libssh2-1.3.0.tar.gz:e2f5f8175ff5b950766328d106c6c420e08ec04f325d862ddfb03fc4535e1ce16b8d76390aad322659d9abe60f054ca9bc12b52f96dbf10e4f992832ac8554a7 && test -f "libssh2-1.3.0.tar.gz" || :
test X"$(openssl dgst -md5 libssh2-1.3.0.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
wget-finder --search-engine brave -O libssh.tar.gz libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709; test -f libssh.tar.gz || :
test X"$(openssl dgst -md5 libssh.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
rm -rf *.tar.gz
wget-finder libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709 libssh2-1.4.0.tar.gz:ee670161d8c5dff93ae84a3f34f15669
test -f libssh2-1.3.0.tar.gz && test -f libssh2-1.4.0.tar.gz
rm -rf *.tar.gz
wget-finder -O file libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709 libssh2-1.4.0.tar.gz:ee670161d8c5dff93ae84a3f34f15669
test -f file && test ! -f libssh2-1.3.0.tar.gz && test ! -f libssh2-1.4.0.tar.gz

wget-finder --checksum a48fefe93507668193135f6aa5f1ed77 -O killramdisk-1.0-2.i386.rpm http://mirrors.mit.edu/kernel/dist/superrescue/v1/RPMS/killramdisk-1.0-2.i386.rpm || :
test ! -f killramdisk-1.0-2.i386.rpm
wget-finder --checksum a48fefe93507668193135f6aa5f1ed77 --keep-wrong-file -O killramdisk-1.0-2.i386.rpm http://mirrors.mit.edu/kernel/dist/superrescue/v1/RPMS/killramdisk-1.0-2.i386.rpm || :
test   -f killramdisk-1.0-2.i386.rpm && rm -rf killramdisk-1.0-2.i386.rpm
wget-finder --checksum a48fefe93507668193135f6aa5f1ed7f -O killramdisk-1.0-2.i386.rpm http://mirrors.mit.edu/kernel/dist/superrescue/v1/RPMS/killramdisk-1.0-2.i386.rpm
test   -f   killramdisk-1.0-2.i386.rpm
@end

@begin{whats}
whats; test X"${?}"                                 = X"1"
whats -h ; test X"${?}"                             = X"0"
printf "%s" '-h' | whats; test X"${?}"              = X"0"
whats --help ; test X"${?}"                         = X"0"
printf "%s" '--help' | whats; test X"${?}"          = X"0"
whats --cui; test X"${?}"                           = X"1"
printf "%s" '--cui' | whats; test X"${?}"           = X"1"
test X"$(whats | head -1)"                          = X""
test X"$(whats 2>&1 | head -1)"                     = X"Usage: whats word ..."
test X"$(whats -h | head -1)"                       = X"Usage: whats word ..."
test X"$(printf "%s" '--help' | whats | head -1)"   = X"Usage: whats word ..."
test X"$(whats --cui | head -1)"                    = X""
test X"$(whats --cui 2>&1|head -1)"                 = X"whats: unrecognized option '--cui'"
@end

@begin{code-freeze}
#@section{setup}
#nothing here is written in the home of whoever runs it and nothing outside the
#sandbox: every repository read below is one this block makes here, and the
#identity git commits with arrives in the environment, so no file of the user is
#written for it and none is read either
HOME="${PWD}/userhome"; export HOME; mkdir -p "${HOME}"
unset XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME GIT_DIR GIT_WORK_TREE GIT_CONFIG GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM GIT_INDEX_FILE GIT_OBJECT_DIRECTORY
GIT_CONFIG_NOSYSTEM="1"; GIT_AUTHOR_NAME="Test"; GIT_AUTHOR_EMAIL="t@test.invalid"; GIT_COMMITTER_NAME="Test"; GIT_COMMITTER_EMAIL="t@test.invalid"
export GIT_CONFIG_NOSYSTEM GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL
#the tool is named by an absolute path wherever a test steps into a repository of
#its own: the PATH this runner writes is ../../tools/, which is relative and
#points somewhere else from inside a subdirectory of the sandbox
cf="$(cd ../../tools && pwd)/code-freeze"
code-freeze -h >/dev/null; test X"${?}"          = X"0"
code-freeze --help >/dev/null; test X"${?}"      = X"0"
code-freeze -V | grep "code-freeze" >/dev/null
test X"$(code-freeze -h | head -1)"              = X"Usage: code-freeze --check|--coverage [PATH]..."
code-freeze >/dev/null 2>&1; test X"${?}"        = X"1"
test X"$(code-freeze 2>&1 >/dev/null | head -1)" = X"code-freeze: say what to do: --check, --coverage or --reviewed"
code-freeze --nonsense >/dev/null 2>&1; test X"${?}"         = X"1"
code-freeze --check --coverage >/dev/null 2>&1; test X"${?}" = X"1"
code-freeze --check --frozen >/dev/null 2>&1; test X"${?}"   = X"1"
code-freeze --reviewed x >/dev/null 2>&1; test X"${?}"       = X"1"
#@section{fixtures}
#one repository, one program, two functions and the rules it sources,
#committed: that commit is the one the tags below name. Its user.email is the
#one --reviewed writes down. A file that is sourced is never run, so it has
#neither a #! nor a .sh, and nothing in how it looks says that it is shell
mkdir -p one && (cd one && git init -q . && git config user.email m@javier.io && git config user.name Reviewer)
printf '%s\n' '#!/bin/sh' '' '_alpha() {' '    printf "a\n"' '}' '' '_beta() {' '    printf "b\n"' '}' > one/prog
printf '%s\n' '#usage: . rules, from a program that sources it' '' '_rule_one() {' '    printf "1\n"' '}' '' '_rule_two() {' '    printf "2\n"' '}' > one/rules
(cd one && git add prog rules && git commit -q -m "one program, two functions and the rules it sources")
onesha="$(cd one && git rev-parse --short HEAD)"
#a repository with nothing tagged in it answers cleanly and says nothing, which
#is the state this repository is in today: a pass on an empty set is a pass
test X"$(cd one && "${cf}" --check)" = X""
(cd one && "${cf}" --check); test X"${?}" = X"0"
#@section{tags}
#both places a tag may sit are read: on the line that defines the function, and
#as the first line inside it
printf '%s\n' '#!/bin/sh' '' "_alpha() { #@frozen 2026-09-18 m@javier.io ${onesha}" '    printf "a\n"' '}' '' '_beta() {' "    #@reviewed 2026-09-19 m@javier.io ${onesha}" '    printf "b\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X""
(cd one && "${cf}" --check); test X"${?}" = X"0"
#a body that moved on is named, with the commit that was read, the state it was
#approved in, and the day and the person that approved it
printf '%s\n' '#!/bin/sh' '' "_alpha() { #@frozen 2026-09-18 m@javier.io ${onesha}" '    printf "otra cosa\n"' '}' '' '_beta() {' "    #@reviewed 2026-09-19 m@javier.io ${onesha}" '    printf "b\n"' '}' > one/prog
(cd one && "${cf}" --check) >/dev/null 2>&1; test X"${?}" = X"1"
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog _alpha changed since ${onesha} (frozen 2026-09-18 by m@javier.io)"
#and the one beside it, which nobody touched, is not named
test X"$(cd one && "${cf}" --check | grep -c '_beta')" = X"0"
#a tag on the first line inside vouches for its body just the same
printf '%s\n' '#!/bin/sh' '' "_alpha() { #@frozen 2026-09-18 m@javier.io ${onesha}" '    printf "a\n"' '}' '' '_beta() {' "    #@reviewed 2026-09-19 m@javier.io ${onesha}" '    printf "b, cambiado\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog _beta changed since ${onesha} (reviewed 2026-09-19 by m@javier.io)"
#the tag line is no part of the body and neither is what trails a line: the same
#function with its tag moved from one place to the other, and with blanks at the
#end of a line, is the function that was approved
printf '%s\n' '#!/bin/sh' '' '_alpha() {' "    #@frozen 2026-09-18 m@javier.io ${onesha}" '    printf "a\n"   ' '}' '' "_beta() { #@reviewed 2026-09-19 m@javier.io ${onesha}" '    printf "b\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X""
#what a tag says about one function says nothing about the next: a function that
#carries none is compared with nothing, changed or not
printf '%s\n' '#!/bin/sh' '' '_alpha() {' "    #@frozen 2026-09-18 m@javier.io ${onesha}" '    printf "a\n"' '}' '' '_beta() {' '    printf "todo otro cuerpo\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X""
#the rules a program sources have no #! and no .sh, and a tag there is read all
#the same: named, because whoever named the file said it is shell, and in the
#sweep, because a file with a tag in it is read whatever it looks like. So the
#sweep counts it, verifies it, and fails the day its body moves on. Its only tag
#is a frozen one, so the sweep has to find a file by either word: asked for the
#word reviewed alone, it would never open this one and would pass on silence
printf '%s\n' '#usage: . rules, from a program that sources it' '' '_rule_one() {' "    #@frozen 2026-09-18 m@javier.io ${onesha}" '    printf "1\n"' '}' '' '_rule_two() {' '    printf "2\n"' '}' > one/rules
test X"$(cd one && "${cf}" --coverage | grep '^rules:')" = X"rules: 2 functions, 0 reviewed, 1 frozen, 0 changed, 1 untagged"
printf '%s\n' '#usage: . rules, from a program that sources it' '' '_rule_one() {' "    #@frozen 2026-09-18 m@javier.io ${onesha}" '    printf "1, cambiado\n"' '}' '' '_rule_two() {' '    printf "2\n"' '}' > one/rules
test X"$(cd one && "${cf}" --check rules)" = X"code-freeze: rules _rule_one changed since ${onesha} (frozen 2026-09-18 by m@javier.io)"
rulescheck="$(cd one && "${cf}" --check)"; test X"${?}" = X"1"
test X"${rulescheck}" = X"code-freeze: rules _rule_one changed since ${onesha} (frozen 2026-09-18 by m@javier.io)"
(cd one && git checkout -q -- rules)
#@section{broken}
#a tag that does not parse is said as it was written, with the line it sits on: a
#field guessed at is how a tag stops meaning anything
printf '%s\n' '#!/bin/sh' '' '_alpha() {' '    #@reviewed 2026-09-18 m@javier.io' '    printf "a\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog:4 has a tag that does not parse: #@reviewed 2026-09-18 m@javier.io"
(cd one && "${cf}" --check) >/dev/null 2>&1; test X"${?}" = X"1"
#the form tags had before, the word always reviewed and the state at the end,
#is no tag any more: it does not parse, on the definition or inside, and
#--check fails on it rather than read it the old way
printf '%s\n' '#!/bin/sh' '' "_alpha() { #@reviewed 2026-09-18 m@javier.io ${onesha} frozen" '    printf "a\n"' '}' '' '_beta() {' "    #@reviewed 2026-09-19 m@javier.io ${onesha} reviewed" '    printf "b\n"' '}' > one/prog
oldcheck="$(cd one && "${cf}" --check)"; test X"${?}" = X"1"
test X"$(printf '%s\n' "${oldcheck}" | awk 'NR == 1')" = X"code-freeze: prog:3 has a tag that does not parse: #@reviewed 2026-09-18 m@javier.io ${onesha} frozen"
test X"$(printf '%s\n' "${oldcheck}" | awk 'NR == 2')" = X"code-freeze: prog:8 has a tag that does not parse: #@reviewed 2026-09-19 m@javier.io ${onesha} reviewed"
test X"$(cd one && "${cf}" --coverage prog)" = X"prog: 2 functions, 0 reviewed, 0 frozen, 0 changed, 2 untagged"
printf '%s\n' '#!/bin/sh' '' '_alpha() {' "    #@frozen 18-09-2026 m@javier.io ${onesha}" '    printf "a\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check | grep -c 'does not parse')" = X"1"
printf '%s\n' '#!/bin/sh' '' '_alpha() {' "    #@frozen 2026-09-18 nadie ${onesha}" '    printf "a\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check | grep -c 'does not parse')" = X"1"
#a commit this repository never had reads as a history that is not here, which
#is what a clone of one commit hands a tag, and not as a function somebody wrote
printf '%s\n' '#!/bin/sh' '' '_alpha() {' '    #@frozen 2026-09-18 m@javier.io deadbeef' '    printf "a\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog _alpha names deadbeef, which this repository does not have"
(cd one && "${cf}" --check) >/dev/null 2>&1; test X"${?}" = X"1"
#and a commit it does have that this HEAD does not is the other half of that
#answer: code approved on a branch nobody merged
(cd one && git checkout -q -b aside && printf '%s\n' '#!/bin/sh' '' '_alpha() {' '    printf "en la rama\n"' '}' > prog && git add prog && git commit -q -m aside)
asidesha="$(cd one && git rev-parse --short HEAD)"
(cd one && git checkout -q - && git checkout -q -- prog)
printf '%s\n' '#!/bin/sh' '' '_alpha() {' "    #@frozen 2026-09-18 m@javier.io ${asidesha}" '    printf "a\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog _alpha names ${asidesha}, which is not an ancestor of HEAD"
#a tag on no function at all, and one inside a function that is neither on its
#definition nor on its first line
printf '%s\n' '#!/bin/sh' '' "#@frozen 2026-09-18 m@javier.io ${onesha}" '_alpha() {' '    printf "a\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog:3 has a tag outside a function"
printf '%s\n' '#!/bin/sh' '' '_alpha() {' '    printf "a\n"' "    #@frozen 2026-09-18 m@javier.io ${onesha}" '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog:5 has a tag inside _alpha that is neither on its definition nor its first line"
#a line that only quotes the word is no tag: this tool carries it in its help and
#in the awk it reads files with, and reads neither of those as one
printf '%s\n' '#!/bin/sh' '' '_quoting() {' '    printf "%s\n" "a tag reads #@reviewed DAY WHO COMMIT, or #@frozen"' '    re="#@reviewed"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X""
test X"$(cd one && "${cf}" --coverage prog)" = X"prog: 1 functions, 0 reviewed, 0 frozen, 0 changed, 1 untagged"
#nor is any other comment that begins #@, even on a line of its own where a tag
#would sit: the test databases mark their sections with #@section{name}
printf '%s\n' '#!/bin/sh' '' '#@section{frozen}' '_alpha() {' '#@section{reviewed}' '    printf "a\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X""
test X"$(cd one && "${cf}" --coverage prog)" = X"prog: 1 functions, 0 reviewed, 0 frozen, 0 changed, 1 untagged"
#and a file with no #! that only quotes the word - in a string, a comment, a
#here-doc, the way this block does - is not swept for it: a file of that shape
#is read when it has a line a tag can be, and the word alone is not one. Named,
#it is read, and the word is no tag there either
printf '%s\n' '#notes nobody sources' '_help() {' '    printf "%s\n" "a tag reads #@reviewed DAY WHO COMMIT, or #@frozen"' '    #the word #@reviewed alone is no tag' '    cat <<EOF' '    _f() { #@frozen 2026-09-18 you@example.com 7638adf' 'EOF' '}' > one/notes
(cd one && git add notes)
test X"$(cd one && "${cf}" --coverage)" = X"prog: 1 functions, 0 reviewed, 0 frozen, 0 changed, 1 untagged"
notesnamed="$(cd one && "${cf}" --check notes)"; test X"${?}" = X"0"
test X"${notesnamed}" = X""
(cd one && git rm -q -f notes)
#a } at the start of a line inside a function - a here-doc, an embedded awk
#program - leaves the rule unable to say where the function ends, and is refused:
#a body cut short compares equal to itself and swears nothing changed past the cut
printf '%s\n' '#!/bin/sh' '' '_hd() {' "    #@frozen 2026-09-18 m@javier.io ${onesha}" '    cat <<EOF' 'static void f()' '{' '    nada;' '}' 'EOF' '}' '' '_after() {' '    printf "x\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog does not say where _hd ends, a } begins a line inside it"
#and one name defined twice in a file leaves a tag there naming no one body
printf '%s\n' '#!/bin/sh' '' '_two() {' "    #@frozen 2026-09-18 m@javier.io ${onesha}" '    printf "1\n"' '}' '' '_two() {' '    printf "2\n"' '}' > one/prog
test X"$(cd one && "${cf}" --check)" = X"code-freeze: prog defines _two more than once, so a tag there names no one body"
(cd one && git checkout -q -- prog)
#@section{renamed}
#a tag has to survive a rename: a tag written before one names a commit where the file had the other name
mkdir -p two && (cd two && git init -q . && git config user.email m@javier.io)
printf '%s\n' '#!/bin/sh' '' '_moved() {' '    printf "m\n"' '}' > two/before
(cd two && git add before && git commit -q -m before)
twosha="$(cd two && git rev-parse --short HEAD)"
(cd two && git mv before after && git commit -q -m "before becomes after")
printf '%s\n' '#!/bin/sh' '' '_moved() {' "    #@frozen 2026-09-18 m@javier.io ${twosha}" '    printf "m\n"' '}' > two/after
test X"$(cd two && "${cf}" --check)" = X""
(cd two && "${cf}" --check); test X"${?}" = X"0"
#and the rename is followed to compare and not to excuse: the same file, moved,
#with a body that moved on as well, is still named
printf '%s\n' '#!/bin/sh' '' '_moved() {' "    #@frozen 2026-09-18 m@javier.io ${twosha}" '    printf "se movio y cambio\n"' '}' > two/after
test X"$(cd two && "${cf}" --check)" = X"code-freeze: after _moved changed since ${twosha} (frozen 2026-09-18 by m@javier.io)"
(cd two && git checkout -q -- after)
#@section{coverage}
#per file: how many functions it has, how many carry a tag of each state, how
#many of those moved on, and how many carry none
printf '%s\n' '#!/bin/sh' '' '_alpha() {' '    printf "a\n"' '}' '' '_beta() {' '    printf "b\n"' '}' '' '_gamma() {' '    printf "g\n"' '}' > one/prog
printf '%s\n' '#!/bin/sh' '' '_uno() {' '    :' '}' '' '_dos() {' '    :' '}' > one/other
(cd one && git add prog other && git commit -q -m three)
threesha="$(cd one && git rev-parse --short HEAD)"
test X"$(cd one && "${cf}" --coverage prog)" = X"prog: 3 functions, 0 reviewed, 0 frozen, 0 changed, 3 untagged"
printf '%s\n' '#!/bin/sh' '' "_alpha() { #@frozen 2026-09-18 m@javier.io ${threesha}" '    printf "a\n"' '}' '' '_beta() {' "    #@reviewed 2026-09-19 m@javier.io ${threesha}" '    printf "b\n"' '}' '' '_gamma() {' '    printf "g\n"' '}' > one/prog
test X"$(cd one && "${cf}" --coverage prog)" = X"prog: 3 functions, 1 reviewed, 1 frozen, 0 changed, 1 untagged"
printf '%s\n' '#!/bin/sh' '' "_alpha() { #@frozen 2026-09-18 m@javier.io ${threesha}" '    printf "cambiado\n"' '}' '' '_beta() {' "    #@reviewed 2026-09-19 m@javier.io ${threesha}" '    printf "b\n"' '}' '' '_gamma() {' '    printf "g\n"' '}' > one/prog
test X"$(cd one && "${cf}" --coverage prog)" = X"prog: 3 functions, 1 reviewed, 1 frozen, 1 changed, 1 untagged"
#and each file counts for itself: the one read after a file full of tags starts
#from none of them
test X"$(cd one && "${cf}" --coverage prog other | tail -1)" = X"other: 2 functions, 0 reviewed, 0 frozen, 0 changed, 2 untagged"
#a report answers for having been written and not for what it found: the status
#of the gate belongs to --check, and so do the findings
(cd one && "${cf}" --coverage prog) >/dev/null 2>&1; test X"${?}" = X"0"
test X"$(cd one && "${cf}" --coverage prog | grep -c 'changed since')" = X"0"
#a tag it could not read leaves its function among the untagged, and the report
#says that in counts, which is the whole of what it says
printf '%s\n' '#!/bin/sh' '' '_alpha() {' '    #@reviewed nada' '    printf "a\n"' '}' '' '_beta() {' '    printf "b\n"' '}' '' '_gamma() {' '    printf "g\n"' '}' > one/prog
test X"$(cd one && "${cf}" --coverage prog)" = X"prog: 3 functions, 0 reviewed, 0 frozen, 0 changed, 3 untagged"
(cd one && git checkout -q -- prog)
#a file with no #! and no .sh is counted when it is named, and left out of the
#sweep while nothing in it carries a tag, as it is when what was named is the
#directory it sits in: a directory says nothing of each file in it. The sweep
#reads the shell files and the tagged ones, and not the completions and the
#test databases beside them
test X"$(cd one && "${cf}" --coverage rules)" = X"rules: 2 functions, 0 reviewed, 0 frozen, 0 changed, 2 untagged"
test X"$(cd one && "${cf}" --coverage | awk -F: '{printf("%s ", $1)}')" = X"other prog "
test X"$(cd one && "${cf}" --coverage . | awk -F: '{printf("%s ", $1)}')" = X"other prog "
#@section{reviewed}
#a tag is written with the word of its state, today, the email git is configured
#with and the short HEAD, on the line that defines the function and one space after its {: that
#line already names the function, and a tag there spends no line of its own
(cd one && "${cf}" --reviewed prog _alpha --yes) >/dev/null 2>&1; test X"${?}" = X"0"
test X"$(awk 'NR == 3' one/prog)" = X"_alpha() { #@reviewed $(date +%Y-%m-%d) m@javier.io ${threesha}"
test X"$(awk 'NR == 4' one/prog)" = X'    printf "a\n"'
test X"$(grep -c '' one/prog)" = X"13"
#and what was just written is what --check reads back, since a tag is no part of
#the body it vouches for
test X"$(cd one && "${cf}" --check prog)" = X""
test X"$(cd one && "${cf}" --coverage prog)" = X"prog: 3 functions, 1 reviewed, 0 frozen, 0 changed, 2 untagged"
#--frozen is the other state, and a function that already carries a tag on the
#line that defines it has that one replaced there and not a second one added
(cd one && git add prog && git commit -q -m tagged)
headsha="$(cd one && git rev-parse --short HEAD)"
(cd one && "${cf}" --reviewed prog _alpha --frozen --yes) >/dev/null 2>&1; test X"${?}" = X"0"
test X"$(grep -c -E '#@(reviewed|frozen)' one/prog)" = X"1"
test X"$(awk 'NR == 3' one/prog)" = X"_alpha() { #@frozen $(date +%Y-%m-%d) m@javier.io ${headsha}"
#a tag on the line that defines the function is replaced on that line
printf '%s\n' '#!/bin/sh' '' '_alpha() { #@frozen 2020-01-01 viejo@ninguna.parte ffff' '    printf "a\n"' '}' > one/prog
(cd one && git add prog && git commit -q -m defline)
deflinesha="$(cd one && git rev-parse --short HEAD)"
(cd one && "${cf}" --reviewed prog _alpha --yes) >/dev/null 2>&1; test X"${?}" = X"0"
test X"$(awk 'NR == 3' one/prog)" = X"_alpha() { #@reviewed $(date +%Y-%m-%d) m@javier.io ${deflinesha}"
test X"$(grep -c -E '#@(reviewed|frozen)' one/prog)" = X"1"
#a tag on the first line inside, where tags used to be written, is moved: that
#line goes and the new tag is written on the line that defines the function
printf '%s\n' '#!/bin/sh' '' '_alpha() {' '    #@frozen 2020-01-01 viejo@ninguna.parte ffff' '    printf "a\n"' '}' > one/prog
(cd one && git add prog && git commit -q -m inside)
insidesha="$(cd one && git rev-parse --short HEAD)"
(cd one && "${cf}" --reviewed prog _alpha --yes) >/dev/null 2>&1; test X"${?}" = X"0"
#and the tag that moved still vouches for the body: the commit it names has the
#tag inside the function and the file has it on the definition, and neither is
#body, so moving it is no change
movedcheck="$(cd one && "${cf}" --check prog)"; test X"${?}" = X"0"
test X"${movedcheck}" = X""
#and the function is left with one tag, on its definition, and nothing else in
#the file is touched
test X"$(grep -c -E '#@(reviewed|frozen)' one/prog)" = X"1"
printf '%s\n' '#!/bin/sh' '' "_alpha() { #@reviewed $(date +%Y-%m-%d) m@javier.io ${insidesha}" '    printf "a\n"' '}' > movedref
cmp one/prog movedref >/dev/null
#the commit a tag records has to describe the code that was read, so a file with
#changes nobody committed is refused and nothing is written
cp one/prog dirtyref
(cd one && "${cf}" --reviewed prog _alpha --yes) >/dev/null 2>&1; test X"${?}" = X"1"
test X"$(cd one && "${cf}" --reviewed prog _alpha --yes 2>&1 >/dev/null | head -1)" = X"code-freeze: prog has changes that are not committed, and the commit a tag names has to be the code that was read"
cmp one/prog dirtyref >/dev/null
#it asks before writing, and with nobody there to answer it writes nothing
(cd one && git add prog && git commit -q -m clean)
cp one/prog askref
(cd one && "${cf}" --reviewed prog _alpha) < /dev/null >/dev/null 2>&1; test X"${?}" = X"1"
cmp one/prog askref >/dev/null
test X"$(cd one && "${cf}" --reviewed prog _alpha < /dev/null 2>&1 >/dev/null | head -1 | awk '{print $NF}')" = X"[y/N]"
#a no writes nothing either, and a yes writes
printf 'n\n' > answer-no && (cd one && "${cf}" --reviewed prog _alpha --frozen < ../answer-no) >/dev/null 2>&1; test X"${?}" = X"1"
cmp one/prog askref >/dev/null
printf 'y\n' > answer-yes && (cd one && "${cf}" --reviewed prog _alpha --frozen < ../answer-yes) >/dev/null 2>&1; test X"${?}" = X"0"
test X"$(awk 'NR == 3' one/prog | awk '{print $3}')" = X"#@frozen"
#a name the file has no function for, and arguments that are not one file and
#one function
(cd one && git add prog && git commit -q -m yes)
test X"$(cd one && "${cf}" --reviewed prog _ninguna --yes 2>&1 >/dev/null | head -1)" = X"code-freeze: prog has no function called _ninguna"
(cd one && "${cf}" --reviewed prog _ninguna --yes) >/dev/null 2>&1; test X"${?}" = X"1"
(cd one && "${cf}" --reviewed prog) >/dev/null 2>&1; test X"${?}" = X"1"
(cd one && "${cf}" --reviewed no-tal-fichero _alpha --yes) >/dev/null 2>&1; test X"${?}" = X"1"
#and a function whose end the rule cannot find is refused before the question is
#asked, not after it
printf '%s\n' '#!/bin/sh' '' '_hd() {' '    cat <<EOF' '{' '}' 'EOF' '}' '' '_after() {' '    printf "x\n"' '}' > one/prog
(cd one && git add prog && git commit -q -m heredoc)
test X"$(cd one && "${cf}" --reviewed prog _hd --yes 2>&1 >/dev/null | head -1)" = X"code-freeze: prog does not say where _hd ends, or defines it more than once"
#and so is a function with something after the { that opens it, a comment or
#the body of a one-liner: a tag written after that is not where a tag is read,
#and what is there is not this tool's to move
printf '%s\n' '#!/bin/sh' '' '_noted() { #a note somebody wrote here' '    printf "n\n"' '}' '' '_one() { printf "1\n"; }' > one/prog
(cd one && git add prog && git commit -q -m noted)
cp one/prog notedref
notedmsg="$(cd one && "${cf}" --reviewed prog _noted < /dev/null 2>&1 >/dev/null)"; test X"${?}" = X"1"
test X"${notedmsg}" = X"code-freeze: prog has something after the { that opens _noted, and a tag has to be the only thing after that {"
onemsg="$(cd one && "${cf}" --reviewed prog _one --yes 2>&1 >/dev/null)"; test X"${?}" = X"1"
test X"${onemsg}" = X"code-freeze: prog has something after the { that opens _one, and a tag has to be the only thing after that {"
cmp one/prog notedref >/dev/null
#the rules a program sources are tagged the same way, and what was written there
#is what the sweep reads back
rulesha="$(cd one && git rev-parse --short HEAD)"
(cd one && "${cf}" --reviewed rules _rule_two --yes) >/dev/null 2>&1; test X"${?}" = X"0"
test X"$(awk 'NR == 7' one/rules)" = X"_rule_two() { #@reviewed $(date +%Y-%m-%d) m@javier.io ${rulesha}"
test X"$(cd one && "${cf}" --coverage | grep '^rules:')" = X"rules: 2 functions, 1 reviewed, 0 frozen, 0 changed, 1 untagged"
#@section{repository}
#and here, over this repository, which is the reason this block exists: an
#approved function somebody changed turns this suite red the same day. The
#sandbox is inside the working tree, so git finds the repository by walking up,
#and the sweep is the one every test above ran over a repository of its own - no
#path given, every shell file git tracks. A clean pass says no tagged function
#changed. It is only worth having if the sweep did read the repository - with no
#tags at all it would pass on nothing - so what it read is asked for as well.
#Each of the two is asked once, because reading it is what it costs
repocheck="$(code-freeze --check)"; test X"${?}" = X"0"
test X"${repocheck}" = X""
repocov="$(code-freeze --coverage)"
test X"$(printf "%s\n" "${repocov}" | awk -F'[:,] *' '$1 == "sh/lib" && $2 + 0 > 50 {print "read"}')" = X"read"
test X"$(printf "%s\n" "${repocov}" | awk -F'[:,] *' '$1 == "sh/tools/code-freeze" {print "read"}')" = X"read"
test X"$(printf "%s\n" "${repocov}" | awk 'END {print (NR > 100) ? "many" : "few"}')" = X"many"
#and what it left out is asked from the same report: this block quotes the tag
#word in its comments and in every fixture it writes, and a file that only
#quotes it is not swept for it
test X"$(printf "%s\n" "${repocov}" | awk -F'[:,] *' '$1 == "sh/tests/tools.db" {print "read"}')" = X""
@end

# vim: set ts=8 sw=4 tw=0 ft=sh :
