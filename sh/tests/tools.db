@begin{ports}
ports -h ; test X"${?}"                                 = X"0"
printf "%s" '-h' | ports; test X"${?}"                  = X"0"
ports --help ; test X"${?}"                             = X"0"
printf "%s" '--help' | ports; test X"${?}"              = X"0"
ports --cui; test X"${?}"                               = X"1"
printf "%s" '--cui' | ports; test X"${?}"               = X"1"
test X"$(ports -h | head -1)"                           = X"Usage: ports [-u] [-a] [-w] [port]"
test X"$(printf "%s" '--help' | ports | head -1)"       = X"Usage: ports [-u] [-a] [-w] [port]"
test X"$(ports --cui | head -1)"                        = X""
test X"$(ports --cui 2>&1|head -1)"                     = X"ports: unrecognized option '--cui'"
test X"$(ports foo 2>&1|head -1)"                       = X"ports: 'foo' is not a port"
test X"$(ports 22 80 2>&1|head -1)"                     = X"ports: one port at a time"
#port 1 needs root to bind, so nothing holds it on a machine running a test suite
ports 1; test X"${?}"                                   = X"1"
test X"$(ports 1 | head -1)"                            = X""
test X"$(ports 1 2>&1|head -1)"                         = X"nothing is listening on 1"
#an option written after the port used to eat the port
test X"$(ports 1 -a 2>&1|head -1)"                      = X"nothing is listening on 1"
test X"$(ports -a 1 2>&1|head -1)"                      = X"nothing is listening on 1"
#-w is not tested past this: the loop it starts does not end on its own
test X"$(ports -w -h | head -1)"                        = X"Usage: ports [-u] [-a] [-w] [port]"
#-U is not tested: it reaches the network and rewrites the file under test
ports -v; test X"${?}"                                  = X"0"
test X"$(ports -v | awk '{print $1}')"                  = X"ports"
test X"$(ports --version | awk 'NF==2{print $1}')"      = X"ports"
@end

@begin{pxe}
pxe -h; test X"${?}"                              = X"0"
printf "%s" '-h' | pxe; test X"${?}"              = X"0"
pxe --help ; test X"${?}"                         = X"0"
printf "%s" '--help' | pxe; test X"${?}"          = X"0"
pxe --cui; test X"${?}"                           = X"1"
printf "%s" '--cui' | pxe; test X"${?}"           = X"1"
test X"$(pxe -h | head -1)"                       = X"Usage: pxe [options] [dir]"
test X"$(printf "%s" '-h' | pxe | head -1)"       = X"Usage: pxe [options] [dir]"
test X"$(pxe --help | head -1)"                   = X"Usage: pxe [options] [dir]"
test X"$(printf "%s" '--help' | pxe | head -1)"   = X"Usage: pxe [options] [dir]"
test X"$(pxe --cui | head -1)"                    = X""
test X"$(pxe --cui 2>&1|head -1)"                 = X"pxe: unrecognized option '--cui'"
test X"$(printf "%s" '--cui' | pxe 2>&1|head -1)" = X"pxe: unrecognized option '--cui'"
pxe && test -d pxe_setup && test -f pxe_setup/menu.c32
pxe cui && test -d cui && test -f cui/menu.c32
@end

@begin{share-backup}
#TODO 25-09-2014 23:09 >> because of being used over ssh, stdin gets blocked
#so reading from pipes is disabled till I figure out a solution
#simple-httpd lives in python/tools, not python: with the directory above
#it, command -v fell through to whatever copy was already on PATH - here
#the one inside the shundle bundle, which is a different checkout
PATH=$PATH:/sbin/:../../../python/tools
share-backup -h; test X"${?}"              = X"0"
share-backup --help ; test X"${?}"         = X"0"
share-backup --cui; test X"${?}"           = X"1"
share-backup stop; test X"${?}"            = X"1"
test X"$(share-backup -h | head -1)"       = X"Usage: share-backup [options] [stop] [directory|file]"
test X"$(share-backup --help | head -1)"   = X"Usage: share-backup [options] [stop] [directory|file]"
test X"$(share-backup --cui  | head -1)"   = X""
test X"$(share-backup --cui 2>&1|head -1)" = X"share-backup: unrecognized option '--cui'"
test X"$(share-backup -u | head -1)"       = X""
test X"$(share-backup -u 2>&1|head -1)"    = X"Option '-u' requires a parameter"
test X"$(share-backup -p 2>&1|head -1)"    = X"Option '-p' requires a parameter"
test X"$(share-backup -P 2>&1|head -1)"    = X"Option '-P' requires a parameter"
test X"$(share-backup -c 2>&1|head -1)"    = X"Option '-c' requires a parameter"
test X"$(share-backup stop)"               = X""
test X"$(share-backup stop 2>&1)"          = X"No instance found"
mkdir foo && printf "%s" "o@o" > foo/cui
share-backup -u cui -p 6230 -P cui foo; test X"${?}" = X"0"
sleep 1
#the pid it will stop is recorded and alive. pgrep for 'share-backup' was
#what used to be here, and it only ever matched because the & left a subshell
#carrying this script's argv sitting above the real server
test -s /tmp/share-backup.lock
kill -0 "$(cat /tmp/share-backup.lock)"
sleep 1
test X"$(curl -s --digest -u cui:cui http://127.0.0.1:6230/cui)" = X"o@o"
share-backup stop; test X"${?}"        = X"0"
#stopped means it stopped answering, which is the only thing a caller cares
#about. The pid is gone with it
test ! -s /tmp/share-backup.lock
test X"$(curl -s -m 3 --digest -u cui:cui http://127.0.0.1:6230/cui)" = X""
share-backup stop; test X"${?}"        = X"1"
share-backup foo > cui; test X"${?}"   = X"0"
address="$(grep address cui | awk '{print $3; exit}')"
passwd="$(grep password cui | awk '{print $2; exit}')"
sleep 1
test X"$(curl -s --digest -u guest:$passwd $address/cui)" = X"o@o"
share-backup stop; test X"${?}"             = X"0"
test ! -s /tmp/share-backup.lock
@end

@begin{static-run}
static-run -h; test X"${?}"                        = X"0"
static-run --help; test X"${?}"                    = X"0"
static-run -V | grep "static-run" >/dev/null
static-run >/dev/null 2>&1; test X"${?}"           = X"1"
static-run --nonsense x >/dev/null 2>&1; test X"${?}" = X"1"
#everything below answers without a network. That the channel directory is a
#variable is the whole reason this block does not depend on anybody's uptime
STATIC_RUN_CHANNELS="$(cd .. && pwd)/static-run.d"; export STATIC_RUN_CHANNELS
STATIC_RUN_HOME="$(pwd)/home"; export STATIC_RUN_HOME
#nothing to serve is 127 and nothing on stdout, so that a caller can tell
#"nothing ran" from a program that ran and failed
static-run --yes nobody-serves-this >/dev/null 2>&1; test X"${?}" = X"127"
test X"$(static-run --yes nobody-serves-this 2>/dev/null)" = X""
static-run --yes nosuchchannel:x >/dev/null 2>&1; test X"${?}" = X"127"
#a native channel beats a confining one that is two hundred times cheaper and
#carries a better badge: class comes before bytes, and no saving on the
#download buys being put inside a box
test X"$(static-run -n tiny | tail -1 | awk '{print $2}')" = X"alpha:tiny@1.0"
test X"$(static-run -n tiny | tail -1 | awk '{print $4, $5, $6, $7}')" = X"nativo, aunque no el"
test X"$(static-run --yes tiny 2>/dev/null | head -1)" = X"alpha"
#the arguments arrive whole, spaces and quotes included
test X"$(static-run tiny 'dos palabras' 2>/dev/null | tail -1)" = X"dos palabras"
test X"$(static-run tiny "con'comilla" 2>/dev/null | tail -1)"  = X"con'comilla"
#stdin belongs to the program being run and not to the resolver
test X"$(printf "%s\n" 'POR EL PIPE' | static-run tiny --cat 2>/dev/null)" = X"POR EL PIPE"
#and on the first resolution as well, which is the run that does the work and
#the one a cached answer never reaches
test X"$(printf "%s\n" 'SIN CACHE' | STATIC_RUN_HOME="$(pwd)/home2" static-run --yes tiny --cat 2>/dev/null)" = X"SIN CACHE"
#and the status the program exits with is its own
static-run tiny --code 3 >/dev/null 2>&1; test X"${?}" = X"3"
#what was placed is named after what is inside it, and the link tree is what
#a placement is: removing one is removing a link
test -d home/store
test -L home/by/alpha/tiny/1.0
test -f home/inventory
test X"$(awk '{print $2}' home/inventory)" = X"alpha:tiny@1.0"
#the second run says nothing at all, which is the whole point of the cache
test X"$(static-run tiny 2>&1 | head -1)" = X"alpha"
#the badge is known before the question, because it is part of what is being
#agreed to and not a detail discovered afterwards
static-run --yes liar:x 2>&1 | grep "\[verified\]" >/dev/null
#a checksum that was published and does not match is not a missing badge, it
#is a different file from the one the project meant to serve
static-run --yes liar:x >/dev/null 2>&1; test X"${?}" = X"127"
test X"$(static-run --yes liar:x 2>&1 | awk '/checksum/ {print $2, $3; exit}')" = X"published checksum"
test ! -L home/by/liar/x/1.0
#purging takes the placement away and collects what nothing points at
static-run --purge alpha:tiny >/dev/null 2>&1
test ! -L home/by/alpha/tiny/1.0
static-run --purge nothing-matches-this >/dev/null 2>&1; test X"${?}" = X"1"
#a channel answers to the names it says it answers to, and the resolver keeps
#no table of them. Both spellings reach the same channel and the answer names
#the real one, so two spellings cannot become two cached decisions
test X"$(static-run -n a:tiny | tail -1 | awk '{print $2}')"    = X"alpha:tiny@1.0"
test X"$(static-run -n alfa:tiny | tail -1 | awk '{print $2}')" = X"alpha:tiny@1.0"
static-run --yes nobodys-nickname:tiny >/dev/null 2>&1; test X"${?}" = X"127"
test X"$(static-run --yes nobodys-nickname:tiny 2>&1)" = X"static-run: no channel called 'nobodys-nickname'"
#the github channel reads a release the same way whatever the sender did with
#whitespace. Its own cache is on disk, so this asks nothing of the network
mkdir -p home/tmp
printf '%s' '{"tag_name":"1.0","assets":[{"name":"thing-x86_64-linux.tar.gz","size":123,"browser_download_url":"http://example.invalid/t"}]}' > home/tmp/github.acme_thing_.json
printf '%s\n' '{' '  "tag_name": "1.0",' '  "assets": [' '    {' '      "name": "thing-x86_64-linux.tar.gz",' '      "size": 123,' '      "browser_download_url": "http://example.invalid/t"' '    }' '  ]' '}' > home/tmp/github.acme_pretty_.json
test X"$(STATIC_RUN_HOME="$(pwd)/home" ../../static-run.d/github probe acme/thing  | awk -F= '$1=="bytes"{print $2}')" = X"123"
test X"$(STATIC_RUN_HOME="$(pwd)/home" ../../static-run.d/github probe acme/pretty | awk -F= '$1=="bytes"{print $2}')" = X"123"
#and a release with nothing this machine can run answers 1, because saying 0
#with nothing to show for it is how a channel that broke passes for one that works
printf '%s' '{"tag_name":"1.0","assets":[{"name":"thing-windows.zip","size":9,"browser_download_url":"http://example.invalid/w"}]}' > home/tmp/github.acme_nix_.json
STATIC_RUN_HOME="$(pwd)/home" ../../static-run.d/github probe acme/nix >/dev/null 2>&1; test X"${?}" = X"1"
#a bare name is a question for a catalog, and this channel refuses to invent
#an owner for one rather than write the package recipe this design avoids
STATIC_RUN_HOME="$(pwd)/home" ../../static-run.d/github probe jq >/dev/null 2>&1; test X"${?}" = X"1"
#a channel that could not reach its catalog did not say no. When it is the
#only one that might have had the package, the answer is that nobody knows;
#"no channel provides" in its place is the lie a rate limit once told about jq
static-run --yes offline >/dev/null 2>&1; test X"${?}" = X"127"
test X"$(static-run --yes offline 2>&1 | head -1)" = X"static-run: down could not be asked: the fake network is down"
test X"$(static-run --yes offline 2>&1 | grep -c 'no channel provides')" = X"0"
#when another channel serves it, it is served, and the silence is named,
#because a cheaper path may have been behind it
test X"$(STATIC_RUN_HOME="$(pwd)/home3" static-run --yes mixed 2>/dev/null | head -1)" = X"alpha"
STATIC_RUN_HOME="$(pwd)/home4" static-run --yes mixed 2>&1 | grep "(down could not be asked" >/dev/null
static-run -n mixed 2>&1 | grep "down: could not be asked" >/dev/null
#and a package nobody has is still reported as exactly that
test X"$(static-run --yes nobody-serves-this 2>&1)" = X"static-run: no channel provides 'nobody-serves-this'"
#the github channel itself, against a curl that answers the way github does
#when it will not answer. A rate limit and a silence are "could not ask", a
#404 is "not there", and none of it touches the network
mkdir -p c403 c404 c000 cspy
printf '%s\n' '#!/bin/sh' 'o=""; while [ $# -gt 0 ]; do [ X"$1" = X"-o" ] && { shift; o="$1"; }; shift; done' 'cat >/dev/null' 'printf "%s" "{\"message\":\"API rate limit exceeded for 1.2.3.4.\"}" > "$o"' 'printf 403' > c403/curl
printf '%s\n' '#!/bin/sh' 'o=""; while [ $# -gt 0 ]; do [ X"$1" = X"-o" ] && { shift; o="$1"; }; shift; done' 'cat >/dev/null' 'printf "%s" "{\"message\":\"Not Found\"}" > "$o"' 'printf 404' > c404/curl
printf '%s\n' '#!/bin/sh' 'cat >/dev/null' 'printf 000' 'exit 7' > c000/curl
chmod 755 c403/curl c404/curl c000/curl
PATH="$(pwd)/c403:${PATH}" STATIC_RUN_HOME="$(pwd)/g1" ../../static-run.d/github probe acme/thing >/dev/null 2>&1; test X"${?}" = X"2"
PATH="$(pwd)/c404:${PATH}" STATIC_RUN_HOME="$(pwd)/g2" ../../static-run.d/github probe acme/thing >/dev/null 2>&1; test X"${?}" = X"1"
PATH="$(pwd)/c000:${PATH}" STATIC_RUN_HOME="$(pwd)/g3" ../../static-run.d/github probe acme/thing >/dev/null 2>&1; test X"${?}" = X"2"
test X"$(PATH="$(pwd)/c403:${PATH}" STATIC_RUN_HOME="$(pwd)/g1" GITHUB_TOKEN= GH_TOKEN= ../../static-run.d/github probe acme/thing | awk '/limit/ && /GITHUB_TOKEN/ {print "limit"}')" = X"limit"
#yesterday's answer about "latest" is still a release that exists, and it is
#used rather than failing when github cannot be asked
mkdir -p g4/tmp
printf '%s' '{"tag_name":"0.9","assets":[{"name":"thing-x86_64-linux.tar.gz","size":77,"browser_download_url":"http://example.invalid/t"}]}' > g4/tmp/github.acme_thing_.json
touch -t 200001010000 g4/tmp/github.acme_thing_.json
test X"$(PATH="$(pwd)/c403:${PATH}" STATIC_RUN_HOME="$(pwd)/g4" ../../static-run.d/github probe acme/thing | awk -F= '$1=="version"{print $2}')" = X"0.9"
#a fresh answer is not asked for again, and being told to look again asks at
#once: without that, --latest would hand back the same release forever
mkdir -p g5/tmp
printf '%s' '{"tag_name":"1.0","assets":[{"name":"thing-x86_64-linux.tar.gz","size":88,"browser_download_url":"http://example.invalid/t"}]}' > g5/tmp/github.acme_thing_.json
PATH="$(pwd)/c404:${PATH}" STATIC_RUN_HOME="$(pwd)/g5" ../../static-run.d/github probe acme/thing >/dev/null 2>&1; test X"${?}" = X"0"
PATH="$(pwd)/c404:${PATH}" STATIC_RUN_HOME="$(pwd)/g5" STATIC_RUN_REFRESH=1 ../../static-run.d/github probe acme/thing >/dev/null 2>&1; test X"${?}" = X"1"
#a token goes to the api through curl's stdin and never on its command line,
#where any other account on the machine could read it out of ps
printf '%s\n' '#!/bin/sh' 'printf "%s\n" "$@" > argv.txt' 'cat > stdin.txt' 'o=""; while [ $# -gt 0 ]; do [ X"$1" = X"-o" ] && { shift; o="$1"; }; shift; done' 'printf "%s" "{}" > "$o"' 'printf 404' > cspy/curl
chmod 755 cspy/curl
PATH="$(pwd)/cspy:${PATH}" STATIC_RUN_HOME="$(pwd)/g6" GITHUB_TOKEN=not-a-real-token ../../static-run.d/github probe acme/thing >/dev/null 2>&1; test X"${?}" = X"1"
test X"$(grep -c not-a-real-token argv.txt)"  = X"0"
test X"$(grep -c not-a-real-token stdin.txt)" = X"1"
#the release reader counts depth and closes an asset with its own object, so
#an object nested inside one cannot lend it a name, and the order its fields
#arrive in does not matter. Both used to go wrong without an error
mkdir -p gj/tmp
printf '%s' '{"tag_name":"v3","assets":[{"name":"real-linux-x86_64.tar.gz","uploader":{"name":"impostor","size":999},"size":444,"browser_download_url":"http://example.invalid/4"}]}' > gj/tmp/github.acme_nested_.json
printf '%s' '{"tag_name":"v4","assets":[{"browser_download_url":"http://example.invalid/5","size":555,"name":"order-linux-x86_64.tar.gz"}]}' > gj/tmp/github.acme_order_.json
test X"$(STATIC_RUN_HOME="$(pwd)/gj" ../../static-run.d/github probe acme/nested | awk -F= '$1=="bytes"{print $2}')" = X"444"
test X"$(STATIC_RUN_HOME="$(pwd)/gj" ../../static-run.d/github probe acme/order  | awk -F= '$1=="bytes"{print $2}')" = X"555"
#"latest" is kept under its own tag as well, so asking for the release by the
#tag that probe reported costs no second request
test -s gj/tmp/github.acme_nested_.json
test X"$(PATH="$(pwd)/c404:${PATH}" STATIC_RUN_HOME="$(pwd)/gj" ../../static-run.d/github locate acme/nested v3 | awk -F= '$1=="format"{print $2}')" = X"tar.gz"
#a name two programs answer to is not resolved by picking one. With nobody to
#ask it is refused and both are named, so the full name is one copy away
static-run --yes twin >/dev/null 2>&1; test X"${?}" = X"127"
test X"$(static-run --yes twin 2>&1 | grep -cE 'twins:(left|right)/twin')" = X"2"
test X"$(static-run --yes right/twin 2>/dev/null)" = X"right"
#with a terminal it asks, and the answer is remembered under the name typed,
#so the second time there is nothing to ask and nobody needs to be there
{ ! script --version 2>/dev/null | grep util-linux >/dev/null; } || test X"$(printf '2\ny\n' | STATIC_RUN_HOME="$(pwd)/tw" script -qec 'static-run twin' /dev/null 2>/dev/null | tr -d '\r' | awk 'NF {l = $NF} END {print l}')" = X"right"
{ ! script --version 2>/dev/null | grep util-linux >/dev/null; } || test X"$(STATIC_RUN_HOME="$(pwd)/tw" static-run twin </dev/null 2>/dev/null)" = X"right"
#--yes means do not ask before spending bytes, and never choose a program for
#the user: even with a terminal there to ask on, the menu is not shown at all.
#No answer is fed in: util-linux script waits two seconds on input the child
#never reads, and a menu never shown is the whole claim. The refusal is checked
#as well, so a script that failed outright cannot pass for a menu not shown
tw2h="$(pwd)/tw2"; tw2out="none was guessed"
{ ! script --version 2>/dev/null | grep util-linux >/dev/null; } || tw2out="$(STATIC_RUN_HOME="${tw2h}" script -qec 'static-run --yes twin' /dev/null </dev/null 2>/dev/null | tr -d '\r')"
test X"$(printf "%s\n" "${tw2out}" | grep -c 'none was guessed')" = X"1"
test X"$(printf "%s\n" "${tw2out}" | grep -c 'which one')" = X"0"
#the aqua channel turns a name into a repository by reading a registry that
#is yaml. A package may open with any of its keys; one that opened with name
#was once merged into its neighbour, which is how nsc came out as someone
#else's program. The index is also refused below a hundred names, so the
#registry is padded to a believable size
i=0; while [ ${i} -lt 120 ]; do printf '  - type: github_release\n    repo_owner: filler\n    repo_name: pkg%s\n' "${i}"; i=$((i+1)); done > filler.yaml
printf '%s\n' 'packages:' '  - type: github_release' '    repo_owner: acme' '    repo_name: jqx' '    description: A JSON thing for tests' '  - name: other/nsc' '    type: github_release' '    repo_owner: other' '    repo_name: nsc-src' '    files:' '      - name: nsc' '  - type: github_release' '    repo_owner: acme' '    repo_name: ripgrepx' '    description: >-' '      searches' '      for text' '    version_constraint: "false"' '    version_overrides:' '      - version_constraint: semver("<= 0.1")' '        files:' '          - name: oldname' '      - version_constraint: "true"' '        files:' '          - name: rgx' '  - type: github_release' '    repo_owner: left' '    repo_name: dup' '    files:' '      - name: dupcmd # a comment yaml drops' '  - type: github_release' '    repo_owner: right' '    repo_name: dup' '    files:' '      - name: dupcmd' > reg.yaml
cat filler.yaml >> reg.yaml
STATIC_RUN_HOME="$(pwd)/aq" STATIC_RUN_AQUA_REGISTRY="$(pwd)/reg.yaml" ../../static-run.d/aqua index >/dev/null
test X"$(awk -F'\t' '$1=="nsc" {print $2}' aq/index/aqua.tsv)" = X"other/nsc-src"
test X"$(awk -F'\t' '$2=="acme/jqx" {n++} END {print n+0}' aq/index/aqua.tsv)" = X"1"
#a command is what the current version calls it, not what an old one did
test X"$(awk -F'\t' '$1=="rgx" {print $2}' aq/index/aqua.tsv)" = X"acme/ripgrepx"
test X"$(awk -F'\t' '$1=="oldname" {n++} END {print n+0}' aq/index/aqua.tsv)" = X"0"
#a comment after a value is not part of it
test X"$(awk -F'\t' '$1=="dupcmd" {n++} END {print n+0}' aq/index/aqua.tsv)" = X"2"
#what the channel answers about a name
STATIC_RUN_HOME="$(pwd)/aq" ../../static-run.d/aqua probe nosuchname >/dev/null 2>&1; test X"${?}" = X"1"
STATIC_RUN_HOME="$(pwd)/aq" ../../static-run.d/aqua probe dupcmd >/dev/null 2>&1; test X"${?}" = X"3"
test X"$(STATIC_RUN_HOME="$(pwd)/aq" ../../static-run.d/aqua probe dupcmd | awk -F= '$1=="candidate"' | awk 'END {print NR}')" = X"2"
STATIC_RUN_HOME="$(pwd)/noindex" ../../static-run.d/aqua probe jqx >/dev/null 2>&1; test X"${?}" = X"2"
STATIC_RUN_HOME="$(pwd)/noindex" ../../static-run.d/aqua probe jqx | grep -- '--index-update' >/dev/null
#searching reads names, repositories and descriptions, folded ones included
test X"$(STATIC_RUN_HOME="$(pwd)/aq" ../../static-run.d/aqua search searches text | awk -F'\t' '{print $1}')" = X"aqua:acme/ripgrepx"
#a registry this reader no longer understands does not replace an index that
#works: every name would silently become "not there"
printf '%s\n' 'packages: []' > broken.yaml
STATIC_RUN_HOME="$(pwd)/aq" STATIC_RUN_AQUA_REGISTRY="$(pwd)/broken.yaml" ../../static-run.d/aqua index >/dev/null 2>&1; test X"${?}" = X"2"
test X"$(awk -F'\t' '$1=="jqx" {print $2}' aq/index/aqua.tsv)" = X"acme/jqx"
#and the whole chain with no network at all: the index names the repository,
#the release is on disk, the artifact is a file here, and the line the user is
#asked about names the owner and not only the word they typed
mkdir -p aq/tmp
printf '%s\n' '#!/bin/sh' 'printf "%s\n" "jqx ran"' > jqx-bin
chmod 755 jqx-bin
printf '{"tag_name":"1.0","assets":[{"name":"jqx-linux-x86_64","size":40,"browser_download_url":"%s"}]}' "$(pwd)/jqx-bin" > aq/tmp/github.acme_jqx_.json
#paths are worked out first: under the runner's sh -x, a command
#substitution nested in an assignment traces into whatever 2>&1 captures
realch="$(cd ../.. && pwd)/static-run.d"; aqh="$(pwd)/aq"; c404="$(pwd)/c404"
test X"$(PATH="${c404}:${PATH}" STATIC_RUN_CHANNELS="${realch}" STATIC_RUN_HOME="${aqh}" static-run --yes jqx 2>/dev/null)" = X"jqx ran"
PATH="${c404}:${PATH}" STATIC_RUN_CHANNELS="${realch}" STATIC_RUN_HOME="${aqh}" static-run -n jqx | grep 'aqua:acme/jqx@1.0' >/dev/null
test X"$(STATIC_RUN_CHANNELS="${realch}" STATIC_RUN_HOME="${aqh}" static-run jqx 2>&1)" = X"jqx ran"
@end

@begin{staticus}
staticus -h; test X"${?}"                = X"0"
staticus --help; test X"${?}"            = X"0"
staticus --cui; test X"${?}"             = X"1"
staticus; test X"${?}"                   = X"1"
test X"$(staticus 2>&1 | head -1)"       = X"Usage: staticus [options] -o staticus.html"
test X"$(staticus -h | head -1 )"        = X"Usage: staticus [options] -o staticus.html"
test X"$(staticus --help | head -1 )"    = X"Usage: staticus [options] -o staticus.html"
test X"$(staticus --cui | head -1)"      = X""
test X"$(staticus --cui 2>&1 | head -1)" = X"staticus: unrecognized option '--cui'"
test X"$(staticus -c | head -1)"         = X""
test X"$(staticus -c 2>&1|head -1)"      = X"Option '-c' requires a parameter"
test X"$(staticus -c file |head -1)"     = X""
test X"$(staticus -c file 2>&1|head -1)" = X"Specified config file 'file' doesn't exists"
test X"$(staticus -m 2>&1|head -1)"      = X"Option '-m' requires a parameter"
test X"$(staticus -o 2>&1|head -1)"      = X"Option '-o' requires a parameter"
test X"$(staticus -O 2>&1|head -1)"      = X"Option '-O' requires a parameter"
test X"$(staticus --txt2html 2>&1|head -1)" = X"Option '--txt2html' requires a parameter"
test X"$(staticus --theme 2>&1|head -1)"    = X"Option '--theme' requires a parameter"
test X"$(staticus --list-modules 2>&1|head -1)" = X"title"
test X"$(staticus --list-themes 2>&1|head -1)"  = X"default"
staticus go; test -f ./staticus.html  && test -f ./staticus.txt
grep "####" ./staticus.txt >/dev/null && grep "Modules" ./staticus.html >/dev/null
rm -rf staticus.*
staticus -o waa.html -O cui.txt; test -f ./waa.html && test -f ./cui.txt
grep "####" ./cui.txt >/dev/null && grep "Modules" ./waa.html >/dev/null
rm -rf cui.txt waa.html
staticus -o waa.html -O cui.txt -m "swap"; test -f ./waa.html && test -f ./cui.txt
grep "####" ./cui.txt >/dev/null && grep "Modules" ./waa.html >/dev/null
test X"$(grep "^#### " ./cui.txt  | wc -l)" = X"1"
test X"$(grep "ID_"  ./waa.html | wc -l)"   = X"1"
staticus -o waa.html -O cui.txt -mmemory,load; test -f ./waa.html && test -f ./cui.txt
grep "####" ./cui.txt >/dev/null && grep "Modules" ./waa.html >/dev/null
grep "load" ./cui.txt >/dev/null && grep "Memory"  ./waa.html >/dev/null
test X"$(grep "^#### " ./cui.txt  | wc -l)" = X"2"
test X"$(grep "ID_"  ./waa.html | wc -l)"   = X"2"
rm -rf cui.txt waa.html
printf "%s\\n" 'modules="notification,memory,load,info"' > conf
staticus -c conf; test -f ./staticus.html  && test -f ./staticus.txt
test X"$(grep "^### " ./staticus.txt  | wc -l)"      = X"1"
test X"$(grep "maintenance" ./staticus.html | wc -l)" = X"1"
test X"$(grep "^#### " ./staticus.txt  | wc -l)"     = X"3"
test X"$(grep "ID_"  ./staticus.html   | wc -l)"     = X"2"
test X"$(grep "Info" ./staticus.html   | wc -l)"     = X"1"
rm -rf staticus.*
@end

@begin{trash}
trash;  test X"${?}"                                = X"1"
trash -h; test X"${?}"                              = X"0"
printf "%s" '-h' | trash; test X"${?}"              = X"0"
trash --help ; test X"${?}"                         = X"0"
printf "%s" '--help' | trash; test X"${?}"          = X"0"
trash --cui; test X"${?}"                           = X"1"
printf "%s" '--cui' | trash; test X"${?}"           = X"1"
test X"$(trash | head -1)"                          = X""
test X"$(trash 2>&1 | head -1)"                     = X"rm: missing operand"
test X"$(trash -h   | head -1)"                     = X"Usage: trash [options] file ..."
#gnu rm help messages change from release to release
test X"$(printf "%s" '--help' | trash | head -1 | awk '{print $1}')"  = X"Usage:"
test X"$(trash --cui | head -1)"                    = X""
test X"$(trash --cui 2>&1|head -1)"                 = X"rm: unrecognized option '--cui'"
test X"$(printf "%s" '--cui' | trash 2>&1|head -1)" = X"rm: unrecognized option '--cui'"
printf "%s" "1" > XaMTWGfu89iQpJk6
trash XaMTWGfu89iQpJk6
test X"$(basename "$(trash -l | grep XaMTWGfu89iQpJk6)")" = X"XaMTWGfu89iQpJk6"
test X"$(basename "$(trash -l XaMTWGfu89iQpJk6)")"        = X"XaMTWGfu89iQpJk6"
printf "%s" "2" > XaMTWGfu89iQpJk6
trash XaMTWGfu89iQpJk6
test X"$(trash -l XaMTWGfu89iQpJk6|wc -l)" = X"2"
trash -yu XaMTWGfu89iQpJk6
test X"$(cat XaMTWGfu89iQpJk6)"            = X"2"
test X"$(cat XaMTWGfu89iQpJk6*.saved)"     = X"1"
trash XaMTWGfu89iQpJk6*
test X"$(trash -l XaMTWGfu89iQpJk6|wc -l)" = X"2"
trash -cy XaMTWGfu89iQpJk6.*saved
test X"$(trash -l XaMTWGfu89iQpJk6|wc -l)" = X"1"
trash -yc XaMTWGfu89iQpJk6
test X"$(trash -l XaMTWGfu89iQpJk6|wc -l)" = X"0"
printf "%s" "1" > XaMTWGfu89iQpJk6
trash -rf XaMTWGfu89iQpJk6
test X"$(trash -l XaMTWGfu89iQpJk6|wc -l)" = X"0"
mkdir XaMTWGfu89iQpJk6
trash XaMTWGfu89iQpJk6
test X"$(trash -l XaMTWGfu89iQpJk6|wc -l)" = X"1"
trash -cy XaMTWGfu89iQpJk6
test X"$(trash -l XaMTWGfu89iQpJk6|wc -l)" = X"0"
mkdir foo && mkdir foo/bar && mkdir foo/bar/rar
printf "%s" "1" > foo/XaMTWGfu89iQpJk6
printf "%s" "2" > foo/bar/XaMTWGfu89iQpJk6
printf "%s" "3" > foo/bar/rar/XaMTWGfu89iQpJk6
trash foo/XaMTWGfu89iQpJk6 foo/bar/XaMTWGfu89iQpJk6 foo/bar/rar/XaMTWGfu89iQpJk6
test X"$(trash -l XaMTWGfu89iQpJk6|wc -l)"    = X"3"
trash -uy XaMTWGfu89iQpJk6
test X"$(cat foo/XaMTWGfu89iQpJk6)"         = X"1"
test X"$(cat foo/bar/XaMTWGfu89iQpJk6)"     = X"2"
test X"$(cat foo/bar/rar/XaMTWGfu89iQpJk6)" = X"3"
@end

@begin{tunnel}
tunnel; test X"${?}"                                            = X"1"
tunnel -h ; test X"${?}"                                        = X"0"
printf "%s" '-h' | tunnel; test X"${?}"                         = X"0"
tunnel --help ; test X"${?}"                                    = X"0"
printf "%s" '--help' | tunnel; test X"${?}"                     = X"0"
tunnel --cui; test X"${?}"                                      = X"1"
printf "%s" '--cui' | tunnel; test X"${?}"                      = X"1"
test X"$(tunnel | head -1)"                                     = X""
test X"$(tunnel 2>&1 | head -1)"                                = X"Usage: tunnel [-s SUBDOMAIN] [-p PROVIDER] [-Q] [host:]port"
test X"$(tunnel -h | head -1)"                                  = X"Usage: tunnel [-s SUBDOMAIN] [-p PROVIDER] [-Q] [host:]port"
test X"$(printf "%s" '--help' | tunnel | head -1)"              = X"Usage: tunnel [-s SUBDOMAIN] [-p PROVIDER] [-Q] [host:]port"
test X"$(tunnel --cui | head -1)"                               = X""
test X"$(tunnel --cui 2>&1|head -1)"                            = X"tunnel: unrecognized option '--cui'"
test X"$(tunnel -s 2>&1|head -1)"                               = X"Option '-s' requires a parameter"
test X"$(tunnel -p 2>&1|head -1)"                               = X"Option '-p' requires a parameter"
test X"$(tunnel foo 2>&1|head -1)"                              = X"tunnel: 'foo' is not a port"
test X"$(tunnel 80 8080 2>&1|head -1)"                          = X"tunnel: one port at a time"
test X"$(tunnel -p cui 8080 2>&1|head -1)"                      = X"tunnel: unknown provider 'cui'"
test X"$(tunnel --no-qr 2>&1|head -1)"                          = X"Usage: tunnel [-s SUBDOMAIN] [-p PROVIDER] [-Q] [host:]port"
test X"$(tunnel -p localhost.run -s demo 8080 2>&1|head -1)"    = X"tunnel: localhost.run has no subdomains, drop -s"
#-U is not tested: it reaches the network and rewrites the file under test
tunnel -v; test X"${?}"                                         = X"0"
test X"$(tunnel -v | awk '{print $1}')"                         = X"tunnel"
test X"$(tunnel --version | awk 'NF==2{print $1}')"             = X"tunnel"
@end

@begin{uimg}
uimg; test X"${?}"                                 = X"1"
uimg -h ; test X"${?}"                             = X"0"
printf "%s" '-h' | uimg; test X"${?}"              = X"0"
uimg --help ; test X"${?}"                         = X"0"
printf "%s" '--help' | uimg; test X"${?}"          = X"0"
uimg --cui; test X"${?}"                           = X"1"
printf "%s" '--cui' | uimg; test X"${?}"           = X"1"
uimg -l; test X"${?}"                              = X"0"
uimg --list-sites; test X"${?}"                    = X"0"
uimg cui; test X"${?}"                             = X"1"
test X"$(uimg      | head -1)"                     = X""
test X"$(uimg 2>&1 | head -1)"                     = X"Usage: uimg image.[png|jpg] ..."
test X"$(uimg -h    | head -1)"                    = X"Usage: uimg image.[png|jpg] ..."
test X"$(printf "%s" '--help' | uimg | head -1)"   = X"Usage: uimg image.[png|jpg] ..."
test X"$(uimg --cui 2>&1|head -1)"                 = X"uimg: unrecognized option '--cui'"
test X"$(printf "%s" '--cui' | uimg 2>&1|head -1)" = X"uimg: unrecognized option '--cui'"
test X"$(uimg cui 2>&1|head -1)"                   = X"'cui' doesn't exist"
touch cui
test X"$(uimg cui 2>&1|head -1)"                   = X"'cui' is not a valid image file"
test X"$(uimg cui cuakcuak 2>&1|wc -l)"            = X"2"
b64_1line="iVBORw0KGgoAAAANSUhEUgAAACAAAAAgAQAAAABbAUdZAAAABGdBTUEAAYagMeiWXwAAAFtJREFU"
b64_2line="eJwtzLEJAzAMBdHr0gSySiALejRvkBU8gsGNCmFFB1Hx4IovqurSpIRszqklUwbnUzRXEuIRsiG/"
b64_3line="SyY9G0JzJSVei9qynm9qyjBpLp0pYW7pbzBl8L8fEIdJL9AvFMkAAAAASUVORK5CYII="
printf "%s\\n%s\\n%s\\n" "${b64_1line}${b64_2line}${b64_3line}" | base64 --decode > wb.png
test -f wb.png
url="$(uimg wb.png)" && rm -rf wb.png && wget "${url}" -O wb.png
test X"$(base64 wb.png 2>&1 | head -1)"   = X"${b64_1line}"
test X"$(uimg wb.png wb.png 2>&1 |wc -l)" = X"2"
@end

