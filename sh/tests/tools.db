@begin{vim-show}
vim-show; test X"${?}"                                 = X"1"
vim-show -h ; test X"${?}"                             = X"0"
printf "%s" '-h' | vim-show; test X"${?}"              = X"0"
vim-show --help ; test X"${?}"                         = X"0"
printf "%s" '--help' | vim-show; test X"${?}"          = X"0"
vim-show --cui; test X"${?}"                           = X"1"
printf "%s" '--cui'  | vim-show; test X"${?}"          = X"1"
test X"$(vim-show | head -1)"                          = X""
test X"$(vim-show 2>&1 | head -1)"                     = X"Usage: vim-show script"
test X"$(vim-show -h | head -1)"                       = X"Usage: vim-show script"
test X"$(printf "%s" '--help' | vim-show | head -1)"   = X"Usage: vim-show script"
test X"$(vim-show --cui | head -1)"                    = X""
test X"$(vim-show --cui 2>&1|head -1)"                 = X"vim-show: unrecognized option '--cui'"
test X"$(printf "%s" '--cui' | vim-show 2>&1|head -1)" = X"vim-show: unrecognized option '--cui'"
test X"$(vim-show cui 2>&1|head -1)"                   = X"vim-show: 'cui' was not found in \$PATH"
test X"$(printf "%s" 'cui' | vim-show 2>&1|head -1)"   = X"vim-show: 'cui' was not found in \$PATH"
@end

@begin{wcd}
HOME="$(pwd)"; export HOME
WCDHOME="${HOME}/.wcd"; export WCDHOME
mkdir -p proyecto.com otro/deep/proyecto node_modules/x
printf "%s\n" '*/node_modules' '#a comment is not a pattern' > .ban.wcd
wcd --help >/dev/null; test X"${?}"                    = X"0"
wcd --bogus 2>/dev/null; test X"${?}"                  = X"1"
test X"$(wcd --help | head -1)" = X"Usage: wcd [--update|--cron|--no-cron|--prune-aliases]"
wcd --update >/dev/null; test -s "${WCDHOME}/.treedata.wcd"
test X"$(grep -c 'node_modules' "${WCDHOME}/.treedata.wcd")"        = X"0"
test X"$(grep -c '/otro/deep/proyecto$' "${WCDHOME}/.treedata.wcd")" = X"1"
test X"$(grep -c '/proyecto.com$' "${WCDHOME}/.treedata.wcd")"       = X"1"
printf "%s\n" "gone ${HOME}/nothing-here" > "${WCDHOME}/.alias.wcd"
wcd --prune-aliases >/dev/null 2>&1; test X"$(wc -l < "${WCDHOME}/.alias.wcd")" = X"0"
printf "%s\n" "live ${HOME}/proyecto.com" > "${WCDHOME}/.alias.wcd"
test X"$(wcd --prune-aliases)" = X"every alias still points at a directory, nothing to prune"
#the crontab half, against a crontab that is a file in this sandbox: the code
#under test rewrites a real user's crontab, and a test that needed the real one
#to prove it would be the last test anyone ran here
mkdir -p fakebin
printf "%s\n" '#!/bin/sh' 'F="$(dirname "$0")/../fake.crontab"' 'case "$1" in -l) [ -f "$F" ] || exit 1; cat "$F" ;; -) cat > "$F" ;; *) exit 2 ;; esac' > fakebin/crontab
chmod +x fakebin/crontab
PATH="$(pwd)/fakebin:${PATH}"; export PATH
printf "%s\n" "0 7 * * * /usr/bin/something-of-the-users" > fake.crontab
wcd --cron >/dev/null; test X"$(grep -c 'wcd --update' fake.crontab)"    = X"1"
wcd --cron >/dev/null; test X"$(grep -c 'wcd --update' fake.crontab)"    = X"1"
test X"$(wcd --cron)" = X"wcd is already in your crontab, nothing to do"
wcd --no-cron >/dev/null; test X"$(grep -c 'wcd --update' fake.crontab)" = X"0"
test X"$(grep -c 'something-of-the-users' fake.crontab)"                 = X"1"
test -f "${WCDHOME}/.nocron"
#and the half that matters, the one that is sourced. It needs a shell whose "."
#passes arguments through and this runner is /bin/sh, which is dash here, so it
#is asked for by name and the rest is skipped where there is none
command -v bash >/dev/null 2>&1 || exit 0
test X"$(bash -c '. ../../tools/wcd otro >/dev/null 2>&1; pwd')"        = X"${HOME}/otro"
test X"$(bash -c '. ../../tools/wcd proyecto >/dev/null 2>&1; pwd')"    = X"${HOME}/otro/deep/proyecto"
test X"$(bash -c '. ../../tools/wcd proyecto.c >/dev/null 2>&1; pwd')"  = X"${HOME}/proyecto.com"
test X"$(bash -c '. ../../tools/wcd nothing-like-this >/dev/null 2>&1; pwd')" = X"${HOME}"
test X"$(bash -c '. ../../tools/wcd nothing-like-this >/dev/null 2>&1')" = X""
bash -c '. ../../tools/wcd nothing-like-this >/dev/null 2>&1'; test X"${?}" = X"1"
rm -f "${WCDHOME}/.alias.wcd"
bash -c '. ../../tools/wcd proyecto "${HOME}/proyecto.com" >/dev/null 2>&1'
test X"$(cat "${WCDHOME}/.alias.wcd")"                                 = X"proyecto ${HOME}/proyecto.com"
test X"$(bash -c '. ../../tools/wcd proyecto >/dev/null 2>&1; pwd')"    = X"${HOME}/proyecto.com"
test X"$(bash -c 'set -- a b c; . ../../tools/wcd otro >/dev/null 2>&1; echo "$*"')" = X"a b c"
#"-" has to be read before the pattern that rejects unknown options, or the
#most used argument cd has becomes an error message
test X"$(bash -c '. ../../tools/wcd otro >/dev/null 2>&1; . ../../tools/wcd proyecto.com >/dev/null 2>&1; . ../../tools/wcd - >/dev/null 2>&1; pwd')" = X"${HOME}/otro"
bash -c '. ../../tools/wcd --nonsense >/dev/null 2>&1'; test X"${?}" = X"1"
@end

@begin{wget-finder}
wget-finder; test X"${?}"                     = X"1"
wget-finder  -h; test X"${?}"                 = X"0"
printf "%s" '-h' | wget-finder; test X"${?}"  = X"0"
wget-finder --help; test X"${?}"              = X"0"
wget-finder --cui; test X"${?}"               = X"2"
wget-finder --search-engine cui; test X"${?}" = X"1"
wget-finder cui; test X"${?}"                 = X"4"
wget-finder libssh2-1.3.0.tar.gz:cui; test X"${?}" = X"1"
test X"$(wget-finder | head -1)"              = X""
test X"$(wget-finder 2>&1 | head -1)"         = X"Usage: wget-finder [OPTION]... FILE:CHECKSUM..."
test X"$(wget-finder -h | head -1)"           = X"Usage: wget-finder [OPTION]... FILE:CHECKSUM..."
test X"$(printf "%s" '--help' | wget-finder | head -1)" = X"Usage: wget-finder [OPTION]... FILE:CHECKSUM..."
test X"$(wget-finder --cui 2>&1|head -1)"     = X"wget: unrecognized option '--cui'"
test X"$(wget-finder --search-engine cui | head -1)"    = X""
test X"$(wget-finder --search-engine cui 2>&1|head -1)" = X"wget-finder: 'cui' is not a recognized search engine"
wget-finder libssh2-1.3.0.tar.gz:cui; test X"${?}" = X"1"

#an engine defined in the environment is listed, accepted and queried, with
#%s standing in for the file. This is the part that has to keep working when
#every built-in engine has stopped answering, so it is tested without a network
WGET_FINDER_ENGINES='zz=http://127.0.0.1:9/?q=%s' wget-finder --list-search-engine | grep -qx "zz"
wget-finder --list-search-engine | grep -qx "zz"; test X"${?}" = X"1"
WGET_FINDER_ENGINES='zz=http://127.0.0.1:9/?q=%s' wget-finder --search-engine zz --list-links libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709; test X"${?}" = X"1"
wget-finder --search-engine zz --list-links libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709 2>&1 | grep -q "not a recognized search engine"
wget-finder --list-search-engine | grep -qx "brave"
wget-finder --list-search-engine | grep -qx "mmnt"

#%s becomes the file being looked for. Asserted against a wget of our own that
#records what it was asked for, so the claim is about the url that goes out
#and not about whether some website answered it
printf "#!/bin/sh\\nprintf \"%%s\\\\n\" \"\${*}\" >> asked.txt\\n" > wget && chmod +x wget
PATH=".:${PATH}" WGET_FINDER_ENGINES='zz=http://engine.invalid/?q=%s' wget-finder --search-engine zz --list-links zlib-1.3.tar.gz:00000000000000000000000000000000 >/dev/null 2>&1; :
grep -q "q=zlib-1.3.tar.gz" asked.txt
grep -q "q=%s" asked.txt; test X"${?}" = X"1"
rm -f wget asked.txt

#and the live half, which depends on companies this repository does not own.
#A search engine that stops answering is not a defect in wget-finder, so these
#report rather than fail: the assertion is that SOME engine still finds links,
#and each one is still exercised so a crash in an extractor is caught
#one line per statement: the runner appends '|| exit 1' to every line it reads,
#which turns any multi-line shell construct into a syntax error
for e in $(wget-finder --list-search-engine); do n="$(wget-finder --search-engine "${e}" --list-links zlib-1.3.tar.gz:00000000000000000000000000000000 2>/dev/null | wc -l)"; printf "%s: %s links\\n" "${e}" "${n}" >&2; [ "${n}" -gt "0" ] && alive="${alive} ${e}"; done; :
[ -n "${alive}" ] || printf "%s\\n" "warning: no search engine returned links" >&2; :

test X"$(wget-finder libssh2-1.3.0.tar.gz:cui  | head -1)" = X""
test X"$(wget-finder libssh2-1.3.0.tar.gz:cui 2>&1 | head -1)" = X"Warning: 'libssh2-1.3.0.tar.gz:cui' is an invalid FILE:CHECKSUM pair, skipping..."
wget-finder libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709; test -f "libssh2-1.3.0.tar.gz" || :
test X"$(openssl dgst -md5 libssh2-1.3.0.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
rm -rf libssh2-1.3.0.tar.gz
wget-finder libssh2-1.3.0.tar.gz:d342e06abe38a29b1bbb9c58d50dd093eab0bee9 && test -f "libssh2-1.3.0.tar.gz" || :
test X"$(openssl dgst -md5 libssh2-1.3.0.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
rm -rf libssh2-1.3.0.tar.gz
wget-finder libssh2-1.3.0.tar.gz:9de377854202f033bfb57ce4f95194a2b1283d45fb243b5e7dca30e058f40f9c && test -f "libssh2-1.3.0.tar.gz" || :
test X"$(openssl dgst -md5 libssh2-1.3.0.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
rm -rf libssh2-1.3.0.tar.gz
wget-finder libssh2-1.3.0.tar.gz:e2f5f8175ff5b950766328d106c6c420e08ec04f325d862ddfb03fc4535e1ce16b8d76390aad322659d9abe60f054ca9bc12b52f96dbf10e4f992832ac8554a7 && test -f "libssh2-1.3.0.tar.gz" || :
test X"$(openssl dgst -md5 libssh2-1.3.0.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
wget-finder --search-engine brave -O libssh.tar.gz libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709; test -f libssh.tar.gz || :
test X"$(openssl dgst -md5 libssh.tar.gz | awk '{print $2}')" = X"6425331899ccf1015f1ed79448cb4709" || :
rm -rf *.tar.gz
wget-finder libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709 libssh2-1.4.0.tar.gz:ee670161d8c5dff93ae84a3f34f15669
test -f libssh2-1.3.0.tar.gz && test -f libssh2-1.4.0.tar.gz
rm -rf *.tar.gz
wget-finder -O file libssh2-1.3.0.tar.gz:6425331899ccf1015f1ed79448cb4709 libssh2-1.4.0.tar.gz:ee670161d8c5dff93ae84a3f34f15669
test -f file && test ! -f libssh2-1.3.0.tar.gz && test ! -f libssh2-1.4.0.tar.gz

wget-finder --checksum a48fefe93507668193135f6aa5f1ed77 -O killramdisk-1.0-2.i386.rpm http://mirrors.mit.edu/kernel/dist/superrescue/v1/RPMS/killramdisk-1.0-2.i386.rpm || :
test ! -f killramdisk-1.0-2.i386.rpm
wget-finder --checksum a48fefe93507668193135f6aa5f1ed77 --keep-wrong-file -O killramdisk-1.0-2.i386.rpm http://mirrors.mit.edu/kernel/dist/superrescue/v1/RPMS/killramdisk-1.0-2.i386.rpm || :
test   -f killramdisk-1.0-2.i386.rpm && rm -rf killramdisk-1.0-2.i386.rpm
wget-finder --checksum a48fefe93507668193135f6aa5f1ed7f -O killramdisk-1.0-2.i386.rpm http://mirrors.mit.edu/kernel/dist/superrescue/v1/RPMS/killramdisk-1.0-2.i386.rpm
test   -f   killramdisk-1.0-2.i386.rpm
@end

@begin{whats}
whats; test X"${?}"                                 = X"1"
whats -h ; test X"${?}"                             = X"0"
printf "%s" '-h' | whats; test X"${?}"              = X"0"
whats --help ; test X"${?}"                         = X"0"
printf "%s" '--help' | whats; test X"${?}"          = X"0"
whats --cui; test X"${?}"                           = X"1"
printf "%s" '--cui' | whats; test X"${?}"           = X"1"
test X"$(whats | head -1)"                          = X""
test X"$(whats 2>&1 | head -1)"                     = X"Usage: whats word ..."
test X"$(whats -h | head -1)"                       = X"Usage: whats word ..."
test X"$(printf "%s" '--help' | whats | head -1)"   = X"Usage: whats word ..."
test X"$(whats --cui | head -1)"                    = X""
test X"$(whats --cui 2>&1|head -1)"                 = X"whats: unrecognized option '--cui'"
@end

