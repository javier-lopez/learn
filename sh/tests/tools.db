test X"$(printf "%s" '-h' | mvs | head -1)"       = X"Usage: mvs [options] file ..."
test X"$(mvs --help | head -1)"                   = X"Usage: mvs [options] file ..."
test X"$(printf "%s" '--help' | mvs | head -1)"   = X"Usage: mvs [options] file ..."
