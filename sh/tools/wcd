#!/bin/sh
#cd wrapper function

#due to cd & subshells nature this script only works if it's sourced
#alias cd=". this_script"
#
#usage: wcd NAME          go to the directory NAME matches
#       wcd NAME PATH     teach the alias NAME -> PATH, go nowhere

WICD_BIN="$(command -v "wcd.exec")"
WICD_OPTIONS="-j -GN -c -i -f ${HOME}/.wcd/.treedata.wcd"
#    -j      just go mode
#    -GN     do not creat go script ($HOME/bin/wicd.go)
#    -c      direct cd mode
#    -i      case insensitve

#how many entries a directory may hold and still be worth listing on arrival.
#The cost this guards is not cpu - ls is 4ms at ten entries and 14ms at a
#thousand, which is the fork and not the listing - it is the screen. Forty
#names is seven lines at 120 columns and ten at 80: still a glance. Past that
#the listing stops telling you where you are and starts scrolling away what
#you were reading. 0 never lists, a large number restores the old behaviour
[ -z "${WCD_LS_MAX}" ] && WCD_LS_MAX="40"

_wcd_ls() {
    #the glob runs inside a subshell on purpose: "set --" in a sourced file
    #overwrites the positional parameters of the shell that sourced it - bash
    #and dash both, and bash does not put them back - and this file is sourced
    #by design. Hidden entries are not counted, which is what ls shows anyway,
    #and an empty directory expands to a literal "*" and counts as one
    ( set -- *; [ "${#}" -le "${WCD_LS_MAX}" ] ) && ls
}

if [ ! -f "${WICD_BIN}" ]; then
    #without the binary this is a plain cd, and a plain cd is not broken - it
    #just cannot jump by a piece of a name, which is the whole point of being
    #here. So say so: once per shell, on stderr, and only when someone asked to
    #go somewhere. Nobody runs "wcd" by hand to find out it is missing; they
    #find out by typing cd and watching it behave like cd
    if [ -n "${1}" ] && [ -z "${WCD_TOLD}" ] && [ -t 2 ]; then
        WCD_TOLD="1"
        printf "%s\n" \
            "wcd: jumping by part of a directory name needs wcd.exec, which is not installed" \
            "     sudo apt install wcd     then:  update-cd" \
            "     (said once per shell; plain cd keeps working meanwhile)" >&2
    fi
    if [ -z "${1}" ]; then
        \cd
    else
        \cd "${@}" && _wcd_ls
    fi
elif [ -n "${2}" ] && [ -d "${2}" ]; then
    #wcd NAME PATH teaches the alias instead of going anywhere. wcd.exec's -l
    #only ever names the directory you are standing in, so the cd happens in a
    #subshell: the caller does not move, and an alias can be taught for a path
    #without leaving the one you are working in.
    #
    #This is the answer to a name that resolves to the wrong place. Beware that
    #an alias does not outrank an exact directory-name match - if some other
    #directory is literally called NAME, that one still wins, and the way out
    #is a name nothing else already answers to
    ( \cd "${2}" 2>/dev/null && "${WICD_BIN}" -GN "-l" "${1}" )
else
    if [ -z "${1}" ]; then
        \cd "$("${WICD_BIN}" ${WICD_OPTIONS} "${HOME}")"
    else
        CD_PATH="$(printf "%s\\n" "$("${WICD_BIN}" ${WICD_OPTIONS} "${@}")" | \
                   sed -e 's:\\::g')"
        \cd "${CD_PATH}" && _wcd_ls
    fi
fi
