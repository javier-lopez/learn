#!/bin/sh
#description: run a command that is not installed, through whatever channel can reach it
#usage: static-run [option]... [channel:]package[@version] [argument]...

#example:
#$ static-run github:jqlang/jq --version
#static-run: jq 1.8.2 -> github:jqlang/jq  2.2 MB  [verified]  native
#jq-1.8.2

VERSION="2026.09.16-03:40"
SRC_URL="https://raw.githubusercontent.com/javier-lopez/learn/master/sh/tools/"

_usage() {
    printf "%s\\n" "Usage: ${PROGNAME} [OPTION]... [CHANNEL:]PACKAGE[@VERSION] [ARGUMENT]..."
    printf "%s\\n" "Run a command this machine does not have installed."
    printf "\\n"
    printf "%b\\n" "  -n, --dry-run        show the path that would be taken, take none"
    printf "%b\\n" "  -a, --apropos words  search the local indexes by what a program does"
    printf "%b\\n" "  -i, --index-update [channel]"
    printf "%b\\n" "                       update the catalogs a bare name is looked up in, and"
    printf "%b\\n" "                       the tools channels install through; one channel's only"
    printf "%b\\n" "  -l, --list           list what is already here"
    printf "%b\\n" "  -b, --bin [name]     the program inside the artifact, when it differs"
    printf "%b\\n" "  -p, --purge [spec]   remove one placement, or everything"
    printf "%b\\n" "  -y, --yes            do not ask before spending bytes"
    printf "%b\\n" "  -L, --latest         resolve again instead of reusing the cached answer"
    printf "%b\\n" "  -e, --ephemeral      use a throwaway root and remove it on exit"
    printf "%b\\n" "  -U, --update         update this program to latest version"
    printf "%s\\n" "  -V, --version        display version"
    printf "%b\\n" "  -v, --verbose        turn on verbose mode"
    printf "%b\\n" "  -q, --quiet          suppress non-error messages"
    printf "%b\\n" "  -h, --help           show this message and exit"
}

_die() {
    [ -z "${1}" ] || printf "%s\\n" "${*}" >&2
    _usage >&2; exit 1
}

#every message this tool makes about itself goes to stderr, so that a program
#it runs owns stdout completely and a pipeline reading from it sees only data
_say() {
    [ -n "${quiet}" ] && return 0
    printf "%s\\n" "${*}" >&2
}

_verbose() {
    [ -z "${verbose}" ] && return 0
    printf "%s\\n" "${*}" >&2
}

_retriever() {
    #$1 => url, $2 => destination file, absent means stdout
    if [ -z "${retriever_bin}" ]; then
        if command -v "curl" >/dev/null 2>&1; then
            retriever_bin="curl"
        elif command -v "wget" >/dev/null 2>&1; then
            retriever_bin="wget"
        else
            printf "%s\\n" "${PROGNAME}: install either 'curl' or 'wget'" >&2
            return 1
        fi
    fi

    #no -k and no --no-check-certificate here, on purpose: this fetches
    #something that is about to be executed, so a certificate that does not
    #check out is the one moment to stop rather than to carry on
    #a location on this machine is copied rather than requested. It is what
    #lets a channel serve from a mirror that is already mounted, and what lets
    #the tests exercise everything below without a network
    case "${1}" in
        file://*|/*|./*)
            _retriever__src="${1#file://}"
            [ -z "${2}" ] && { cat "${_retriever__src}"; return "${?}"; }
            cp "${_retriever__src}" "${2}" 2>/dev/null
            return "${?}" ;;
    esac

    case "${retriever_bin}" in
        curl) [ -z "${2}" ] && { curl -fsSL "${1}"; return "${?}"; }
              curl -fsSL -o "${2}" "${1}" ;;
        wget) [ -z "${2}" ] && { wget -q -O- "${1}"; return "${?}"; }
              wget -q -O "${2}" "${1}" ;;
    esac
}

_digest() {
    #the name of a thing is what is inside it, so that two channels serving
    #the same bytes land in the same place and an interrupted download cannot
    #be mistaken for a finished one
    [ -f "${1}" ] || return 1

    if command -v "sha256sum" >/dev/null 2>&1; then
        sha256sum "${1}" | awk '{print $1; exit}'
    elif command -v "shasum" >/dev/null 2>&1; then
        shasum -a 256 "${1}" | awk '{print $1; exit}'
    elif command -v "openssl" >/dev/null 2>&1; then
        openssl dgst -sha256 "${1}" | awk '{print $NF; exit}'
    else
        return 1
    fi
}

_human() {
    #bytes as the user reads them, and a dash when the catalog did not say
    case "${1}" in
        ''|-|*[!0-9]*) printf "%s" "-"; return 0 ;;
    esac
    awk -v b="${1}" 'BEGIN {
        if (b < 1024)        { printf("%d B", b) }
        else if (b < 1048576){ printf("%.1f KB", b/1024) }
        else                 { printf("%.1f MB", b/1048576) }
    }'
}

_mkdir_p() {
    [ -z "${1}" ] && return 1
    [ -d "${1}" ] && return 0
    mkdir -p "${1}" 2>/dev/null
}

_realpath() {
    #where this file really lives, which is not where it was called from: the
    #plugin manager exposes every tool as a link in a directory on the PATH,
    #so ${0%/*} is that directory and the channels are not next to it
    _realdir__path="${1}"
    _realdir__hops="0"
    while [ -L "${_realdir__path}" ] && [ "${_realdir__hops}" -lt "16" ]; do
        _realdir__link="$(readlink "${_realdir__path}" 2>/dev/null)" || break
        case "${_realdir__link}" in
            /*) _realdir__path="${_realdir__link}" ;;
             *) _realdir__path="${_realdir__path%/*}/${_realdir__link}" ;;
        esac
        _realdir__hops="$((${_realdir__hops} + 1))"
    done
    case "${_realdir__path}" in
        */*) printf "%s\\n" "${_realdir__path}" ;;
          *) printf "%s\\n" "./${_realdir__path}" ;;
    esac
}

_realdir() {
    _realdir__real="$(_realpath "${1}")"
    printf "%s\\n" "${_realdir__real%/*}"
}

###############################################################################
################################### layout ####################################
###############################################################################

_home() {
    if [ -n "${STATIC_RUN_HOME}" ]; then
        printf "%s\\n" "${STATIC_RUN_HOME}"
    elif [ -n "${XDG_CACHE_HOME}" ]; then
        printf "%s\\n" "${XDG_CACHE_HOME}/static-run"
    else
        printf "%s\\n" "${HOME}/.cache/static-run"
    fi
}

_channels_dir() {
    #an environment variable replaces the directory outright, which is how the
    #tests hand this program channels that answer without a network
    [ -n "${STATIC_RUN_CHANNELS}" ] && { printf "%s\\n" "${STATIC_RUN_CHANNELS}"; return 0; }
    #next to this file. The plugin manager exposes regular files only, so the
    #directory never shows up as a command, and a checkout, a bundle and a
    #copy all carry their channels with them
    #named after the file itself and not the name it was run by, so a link
    #called sr still finds static-run.d
    _channels_dir__real="$(_realpath "${0}")"
    printf "%s\\n" "${_channels_dir__real}.d"
}

_channels() {
    #order comes from the configuration file when there is one, and from the
    #directory otherwise. '#' comments a line and '!' turns a channel off,
    #which is the exclusion convention the rest of this setup already uses
    _channels__dir="$(_channels_dir)"
    [ -d "${_channels__dir}" ] || return 1

    _channels__conf="${home}/channels"
    [ -f "${_channels__conf}" ] || _channels__conf=""

    if [ -n "${_channels__conf}" ]; then
        while read -r _channels__line; do
            case "${_channels__line}" in
                ''|'#'*|'!'*) continue ;;
            esac
            [ -x "${_channels__dir}/${_channels__line}" ] && \
                printf "%s\\n" "${_channels__line}"
        done < "${_channels__conf}"
    else
        for _channels__f in "${_channels__dir}"/*; do
            [ -f "${_channels__f}" ] || continue
            [ -x "${_channels__f}" ] || continue
            printf "%s\\n" "${_channels__f##*/}"
        done
    fi
}

_channel_by_alias() {
    #a name that is not a file may still be a name some channel answers to.
    #The channel declares its own aliases, so the resolver keeps no table of
    #other people's nicknames, and this is only asked when the plain name
    #missed, so the ordinary path pays nothing for it
    for _cba__c in $(_channels); do
        _cba__hit="$("$(_channels_dir)/${_cba__c}" meta 2>/dev/null | \
            awk -F= -v want="${1}" '$1 == "aliases" {
                n = split($2, a, ",")
                for (i = 1; i <= n; i++) if (a[i] == want) { print "1"; exit }
            }')"
        [ -n "${_cba__hit}" ] && { printf "%s\\n" "${_cba__c}"; return 0; }
    done
    return 1
}

_channel_meta() {
    #$1 => channel, $2 => key. A channel that says nothing is an artifact
    #channel that confines nothing and describes itself, which is the common
    #case and the one worth not having to write down
    _channel_meta__value="$("$(_channels_dir)/${1}" meta 2>/dev/null | \
        awk -F= -v k="${2}" '$1 == k {print $2; exit}')"

    if [ -z "${_channel_meta__value}" ]; then
        case "${2}" in
            kind)      _channel_meta__value="artifact" ;;
            confines)  _channel_meta__value="no"       ;;
            describes) _channel_meta__value="self"     ;;
        esac
    fi
    printf "%s\\n" "${_channel_meta__value}"
}

###############################################################################
#################################### spec #####################################
###############################################################################

#a spec is (catalog, identifier, version constraint). A bare name is a spec
#with the first two thirds missing, and this program does not invent them
_spec_channel() {
    case "${1}" in
        [a-z0-9]*:*)
            _spec_channel__c="${1%%:*}"
            case "${_spec_channel__c}" in
                *[!a-z0-9-]*) printf "%s\\n" "" ;;
                           *) printf "%s\\n" "${_spec_channel__c}" ;;
            esac ;;
        *) printf "%s\\n" "" ;;
    esac
}

_spec_package() {
    _spec_package__p="${1}"
    case "$(_spec_channel "${1}")" in
        ?*) _spec_package__p="${_spec_package__p#*:}" ;;
    esac
    printf "%s\\n" "${_spec_package__p%%@*}"
}

_spec_version() {
    case "${1}" in
        *@*) printf "%s\\n" "${1##*@}" ;;
          *) printf "%s\\n" "" ;;
    esac
}

###############################################################################
################################## resolution #################################
###############################################################################

_is_number() {
    case "${1}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    return 0
}

_now_ms() {
    #milliseconds, where date can say them, and whole seconds where it cannot
    _nm__t="$(date +%s%N 2>/dev/null)"
    case "${_nm__t}" in
        ''|*[!0-9]*) printf "%s\\n" "$(( $(date +%s) * 1000 ))" ;;
        *) printf "%s\\n" "$(( _nm__t / 1000000 ))" ;;
    esac
}

_timing_add() {
    #$1 => channel, $2 => what was timed: index, tool, fetch or install,
    #$3 => bytes, $4 => milliseconds. Kept in the channel's own directory
    case "${3}${4}" in
        ''|*[!0-9]*) return 0 ;;
    esac
    [ "${3}" -gt "0" ] || return 0
    _ta__home="$(_channel_home "${1}")"
    _mkdir_p "${_ta__home}" || return 0
    printf "%s\\t%s\\t%s\\n" "${2}" "${3}" "${4}" >> "${_ta__home}/timings"
}

_speed() {
    #$1 => channel, $2 => what: bytes a second, as measured on this machine
    #over the last ten times, or a megabyte a second when there is no record
    #yet. Whatever a step costs besides its bytes - a tool unpacking, linking,
    #starting - is in the measure, since what is timed is the whole step
    _sp__f="$(_channel_home "${1}")/timings"
    _sp__v=""
    [ -f "${_sp__f}" ] && _sp__v="$(awk -F'\t' -v s="${2}" '
        $1 == s && $2 > 0 { b[++n] = $2; m[n] = $3 }
        END {
            k = (n > 10) ? n - 9 : 1
            for (i = k; i <= n; i++) { tb += b[i]; tm += m[i] }
            if (tb > 0) { if (tm < 1) tm = 1; printf("%d\n", tb * 1000 / tm) }
        }' "${_sp__f}")"
    printf "%s\\n" "${_sp__v:-1048576}"
}

_est_us() {
    #$1 => bytes, $2 => channel, $3 => what. Microseconds it should take here:
    #whole milliseconds tie two small downloads that are not the same size
    case "${1}" in
        ''|*[!0-9]*) printf "%s\\n" "-"; return 0 ;;
    esac
    awk -v b="${1}" -v s="$(_speed "${2}" "${3}")" 'BEGIN { printf("%d\n", b * 1000000 / s) }'
}

_human_us() {
    case "${1}" in
        ''|*[!0-9]*) printf "%s" "time unknown"; return 0 ;;
    esac
    awk -v u="${1}" 'BEGIN {
        if (u < 1000000)       printf("<1 s")
        else if (u < 90000000) printf("~%d s", (u + 500000) / 1000000)
        else                   printf("~%d min", (u + 30000000) / 60000000)
    }'
}

_probe_emit() {
    #$1 => channel, $2 => what its probe answered, $3 => its status, $4 => the
    #package asked about. Prints the candidate line, already carrying the sort
    #key, or the line that says why there is none. Answers 0 when the channel
    #had the name
    _pe__c="${1}"; _pe__out="${2}"; _pe__rc="${3}"; _pe__pkg="${4}"
    case "${_pe__rc}" in
        0) ;;
        2)  #a channel that could not be asked did not say no, and is kept
            #apart so it is never reported as one: that is how "the network
            #is down" reaches the user as "this does not exist"
            _pe__why="$(printf "%s\\n" "${_pe__out}" | \
                awk '/^unreachable=/ {sub(/^unreachable=/, ""); print; exit}')"
            printf "~unreachable %s %s\\n" "${_pe__c}" "${_pe__why:-it gave no reason}"
            return 1 ;;
        3)  #a name that belongs to more than one package is not resolved
            #by picking one. Which program was meant is the user's to say
            printf "~ambiguous %s %s\\n" "${_pe__c}" \
                "$(printf "%s\\n" "${_pe__out}" | \
                    awk '/^candidate=/ {sub(/^candidate=/, ""); printf("%s ", $0)}')"
            return 0 ;;
        *) return 1 ;;
    esac

    _pe__v="$(printf "%s\\n" "${_pe__out}" | awk -F= '$1=="version"{print $2; exit}')"
    _pe__b="$(printf "%s\\n" "${_pe__out}" | awk -F= '$1=="bytes"{print $2; exit}')"
    _pe__g="$(printf "%s\\n" "${_pe__out}" | awk -F= '$1=="badge"{print $2; exit}')"
    [ -z "${_pe__v}" ] && return 1
    [ -z "${_pe__g}" ] && _pe__g="none"
    #a catalog that turns a name into a repository says which one, and that
    #repository is what gets shown, placed and asked about from here
    _pe__p="$(printf "%s\\n" "${_pe__out}" | awk -F= '$1=="package"{print $2; exit}')"
    [ -z "${_pe__p}" ] && _pe__p="${_pe__pkg}"
    #a channel that installs through a tool of its own names that tool as a
    #spec, and the resolver gets it the way it gets anything else
    _pe__r="$(printf "%s\\n" "${_pe__out}" | awk -F= '$1=="requires"{print $2; exit}')"
    [ -z "${_pe__r}" ] && _pe__r="-"
    #a size the channel could only estimate is said to be one wherever it is
    #shown, and still sorts by what was estimated
    _pe__e="$(printf "%s\\n" "${_pe__out}" | awk -F= '$1=="estimate"{print $2; exit}')"
    [ X"${_pe__e}" = X"yes" ] || _pe__e="-"

    _pe__conf="$(_channel_meta "${_pe__c}" confines)"
    _pe__class="0"
    [ X"${_pe__conf}" = X"yes" ] && _pe__class="1"

    #marginal bytes: what is already placed costs nothing to place again. The
    #package is fetched by static-run, or installed by the channel's tool, and
    #each is timed apart, since a tool that unpacks and links takes longer per
    #byte than a download
    _pe__marginal="${_pe__b}"
    [ -e "$(_channel_home "${_pe__c}")/by/${_pe__p}/${_pe__v}" ] && _pe__marginal="0"
    _pe__step="fetch"; [ X"${_pe__r}" != X"-" ] && _pe__step="install"
    _pe__ms="$(_est_us "${_pe__marginal}" "${_pe__c}" "${_pe__step}")"

    #and what is still missing includes the tool the channel installs through.
    #A channel already fetched costs nothing, so one not fetched yet costs what
    #fetching it does, in bytes and in time, and that is also the hop
    _pe__hops="0"
    if [ X"${_pe__r}" != X"-" ] && ! _tool_here "${_pe__c}" >/dev/null; then
        _pe__hops="1"
        _pe__rb="$(_requires_bytes "${_pe__r}")"
        _pe__rms="$(_est_us "${_pe__rb}" "${_pe__c}" "tool")"
        #an unknown plus anything is unknown, and each side is checked on its
        #own: glued together, an empty one hides behind the other one's digits
        if _is_number "${_pe__marginal}" && _is_number "${_pe__rb}"; then
            _pe__marginal="$((${_pe__marginal} + ${_pe__rb}))"
        else
            _pe__marginal="-"
        fi
        if _is_number "${_pe__ms}" && _is_number "${_pe__rms}"; then
            _pe__ms="$((${_pe__ms} + ${_pe__rms}))"
        else
            _pe__ms="-"
        fi
    fi

    #a path is quicker than another by class first, then by the time it should
    #take here, then by hops. Class before time is the whole point - no saving
    #buys being put inside a container - and a time nobody can estimate sorts
    #last within its class
    case "${_pe__ms}" in
        ''|*[!0-9]*) _pe__key="99999999999999" ;;
                  *) _pe__key="$(awk -v t="${_pe__ms}" 'BEGIN {printf("%014d", t)}')" ;;
    esac

    printf "%s %s %s %s %s %s %s %s %s %s %s %s\\n" \
        "${_pe__class}${_pe__key}${_pe__hops}" "${_pe__c}" \
        "${_pe__v}" "${_pe__b}" "${_pe__g}" \
        "${_pe__conf}" "$(_channel_meta "${_pe__c}" describes)" \
        "${_pe__p}" "${_pe__r}" "${_pe__e}" "${_pe__marginal:--}" "${_pe__ms:--}"
    return 0
}

_first_catalogs() {
    #$1 => package, $2 => version, then the channels with no catalog here. The
    #first time, getting to run the command is what matters, so the catalogs
    #are all fetched at once and each is read as it arrives. The first that has
    #the name is taken, and the ones still arriving are stopped keeping what
    #arrived: the next time the catalogs here do not have a name, they go on
    #from there
    _fc__pkg="${1}"; _fc__ver="${2}"; shift 2
    _mkdir_p "${home}/tmp" || return 1
    _say "${PROGNAME}: no catalog here has '${_fc__pkg}'; fetching $(printf "%s\\n" "${@}" | \
        awk 'NF {a[++n] = $0} END {for (i = 1; i <= n; i++) printf("%s%s", (i == 1 ? "" : (i == n ? " and " : ", ")), a[i])}') at once"
    _fc__run=""
    for _fc__c in "${@}"; do
        "$(_channels_dir)/${_fc__c}" index > "${home}/tmp/index.$$.${_fc__c}" 2>/dev/null &
        _fc__run="${_fc__run} ${_fc__c}:${!}:$(_now_ms)"
    done

    while [ -n "${_fc__run}" ]; do
        _fc__left=""
        for _fc__e in ${_fc__run}; do
            _fc__c="${_fc__e%%:*}"; _fc__rest="${_fc__e#*:}"
            _fc__pid="${_fc__rest%%:*}"; _fc__t0="${_fc__rest#*:}"
            if kill -0 "${_fc__pid}" 2>/dev/null; then
                _fc__left="${_fc__left} ${_fc__e}"
                continue
            fi
            wait "${_fc__pid}"; _fc__rc="${?}"
            _fc__out="$(cat "${home}/tmp/index.$$.${_fc__c}" 2>/dev/null)"
            rm -f "${home}/tmp/index.$$.${_fc__c}"
            if [ "${_fc__rc}" -ne "0" ]; then
                _fc__why="$(printf "%s\\n" "${_fc__out}" | awk '/^unreachable=/ {sub(/^unreachable=/, ""); print; exit}')"
                _say "${PROGNAME}: ${_fc__c}: not fetched, ${_fc__why:-it gave no reason}"
                printf "~unreachable %s %s\\n" "${_fc__c}" "${_fc__why:-its catalog could not be fetched}"
                continue
            fi
            _timing_add "${_fc__c}" "index" \
                "$(printf "%s\\n" "${_fc__out}" | awk -F= '$1 == "bytes" {print $2; exit}')" \
                "$(( $(_now_ms) - _fc__t0 ))"
            _say "${PROGNAME}: ${_fc__c}: $(printf "%s\\n" "${_fc__out}" | \
                awk -F= 'NF == 2 && $1 != "bytes" {printf("%s%s %s", (n++ ? ", " : ""), $2, $1)}')"
            _fc__probe="$("$(_channels_dir)/${_fc__c}" probe "${_fc__pkg}" "${_fc__ver}" 2>/dev/null)"
            if _probe_emit "${_fc__c}" "${_fc__probe}" "${?}" "${_fc__pkg}"; then
                #the answer is here: whatever is still arriving is stopped, and
                #keeps what arrived for the next time it is needed
                _fc__paused=""
                for _fc__o in ${_fc__left} $(printf "%s\\n" "${_fc__run}" | awk -v e="${_fc__e}" '{
                        for (i = 1; i <= NF; i++) if (seen) print $i; else if ($i == e) seen = 1 }'); do
                    _fc__oc="${_fc__o%%:*}"; _fc__ot0="${_fc__o##*:}"
                    _fc__opid="${_fc__o#*:}"; _fc__opid="${_fc__opid%%:*}"
                    if kill -0 "${_fc__opid}" 2>/dev/null; then
                        kill "${_fc__opid}" 2>/dev/null
                        wait "${_fc__opid}" 2>/dev/null
                        _fc__paused="${_fc__paused:+${_fc__paused}, }${_fc__oc}"
                    elif wait "${_fc__opid}" 2>/dev/null; then
                        #one that arrived meanwhile is kept as it is, and what
                        #it took is kept too, without holding anything up
                        _timing_add "${_fc__oc}" "index" "$(awk -F= '$1 == "bytes" {print $2; exit}' \
                            "${home}/tmp/index.$$.${_fc__oc}" 2>/dev/null)" "$(( $(_now_ms) - _fc__ot0 ))"
                    fi
                    rm -f "${home}/tmp/index.$$.${_fc__oc}"
                done
                [ -n "${_fc__paused}" ] && \
                    _say "${PROGNAME}: ${_fc__c} has '${_fc__pkg}'; ${_fc__paused} paused, to go on when needed"
                return 0
            fi
            _say "${PROGNAME}: ${_fc__c} has nothing called '${_fc__pkg}'"
        done
        _fc__run="${_fc__left}"
        [ -n "${_fc__run}" ] && { sleep 0.1 2>/dev/null || sleep 1; }
    done
    return 1
}

_probe_all() {
    #$1 => package, $2 => version, $3 => channel or empty for all of them.
    #One line per candidate, carrying its sort key, sorted
    _probe_all__pkg="${1}"; _probe_all__ver="${2}"; _probe_all__only="${3}"
    {
        _probe_all__found=""; _probe_all__missing=""
        for _probe_all__c in $(_channels); do
            [ -n "${_probe_all__only}" ] && \
                [ X"${_probe_all__only}" != X"${_probe_all__c}" ] && continue
            _probe_all__out="$("$(_channels_dir)/${_probe_all__c}" probe \
                "${_probe_all__pkg}" "${_probe_all__ver}" 2>/dev/null)"
            _probe_all__rc="${?}"
            #a channel with no catalog here is left for below: its catalog is
            #only fetched when the ones here do not have the name
            if [ X"${_probe_all__rc}" = X"2" ] && \
               printf "%s\\n" "${_probe_all__out}" | grep -x 'needs=index' >/dev/null; then
                _probe_all__missing="${_probe_all__missing} ${_probe_all__c}"
                continue
            fi
            _probe_emit "${_probe_all__c}" "${_probe_all__out}" "${_probe_all__rc}" \
                "${_probe_all__pkg}" && _probe_all__found="1"
        done
        if [ -z "${_probe_all__found}" ] && [ -n "${_probe_all__missing}" ]; then
            _first_catalogs "${_probe_all__pkg}" "${_probe_all__ver}" ${_probe_all__missing}
        fi
    } | LC_ALL=C sort
}

_requires_bytes() {
    #$1 => the spec of a tool a channel installs through. What fetching it
    #costs, asked once per resolution however many channels need it
    case "${_requires_memo}" in
        *"
${1} "*) printf "%s\\n" "${_requires_memo}" | awk -v s="${1}" '$1 == s {print $2; exit}'
             return 0 ;;
    esac
    _rb__ch="$(_spec_channel "${1}")"; _rb__pkg="$(_spec_package "${1}")"
    _rb__n="$("$(_channels_dir)/${_rb__ch}" probe "${_rb__pkg}" "" 2>/dev/null | \
        awk -F= '$1 == "bytes" && $2 ~ /^[0-9]+$/ {print $2; exit}')"
    _requires_memo="${_requires_memo}
${1} ${_rb__n:--}"
    [ -n "${_rb__n}" ] && printf "%s\\n" "${_rb__n}"
    return 0
}

_tty() {
    #whether there is a terminal to ask on. Permissions say nothing about that:
    #without a controlling terminal - cron, a service, setsid - /dev/tty is
    #there and writable, and opening it fails. Opening it is the only answer,
    #and it is tried in a subshell: a redirection that fails on a special
    #builtin such as : ends a posix shell outright, status 2 and no message
    ( : > /dev/tty ) 2>/dev/null
}

_confirm() {
    #the question goes to the terminal and not to stdin, because stdin belongs
    #to the program being resolved: 'printf data | jq .' has to keep its data
    [ -n "${assume_yes}" ] && return 0

    if _tty; then
        printf "%s" "${1} [y/N] " > /dev/tty
        read -r _confirm__answer < /dev/tty || return 1
        case "${_confirm__answer}" in
            y|Y|s|S|yes|YES|si|SI) return 0 ;;
            *) return 1 ;;
        esac
    fi

    #no terminal to ask with. Spending bytes without being able to say so is
    #the one thing this must not do, so it declines and says why
    _say "${PROGNAME}: no terminal to ask on, and nothing was downloaded"
    _say "${PROGNAME}: pass --yes if this is meant to run unattended"
    return 1
}

_choose() {
    #$1 => the name, $2 => one channel:package per line. Prints the choice.
    #The terminal is asked and not stdin, for the same reason as _confirm, and
    #with no terminal there is nobody to ask, so nothing is chosen
    _tty || return 1
    [ -n "${assume_yes}" ] && return 1

    printf "%s\\n" "${PROGNAME}: '${1}' is the name of more than one program:" > /dev/tty
    printf "%s\\n" "${2}" | awk 'NF {printf("  %d) %s\n", NR, $0)}' > /dev/tty
    printf "%s" "which one? [number, anything else cancels] " > /dev/tty
    read -r _choose__n < /dev/tty || return 1
    case "${_choose__n}" in
        ''|*[!0-9]*) return 1 ;;
    esac
    _choose__pick="$(printf "%s\\n" "${2}" | awk -v n="${_choose__n}" 'NF && NR == n {print; exit}')"
    [ -z "${_choose__pick}" ] && return 1
    printf "%s\\n" "${_choose__pick}"
}

_unpack() {
    #$1 => artifact, $2 => format, $3 => destination directory
    _mkdir_p "${3}" || return 1
    case "${2}" in
        tar.gz|tgz)  tar -xzf "${1}" -C "${3}" 2>/dev/null ;;
        tar.xz|txz)  tar -xJf "${1}" -C "${3}" 2>/dev/null ;;
        tar.bz2|tbz) tar -xjf "${1}" -C "${3}" 2>/dev/null ;;
        tar)         tar -xf  "${1}" -C "${3}" 2>/dev/null ;;
        zip)         command -v unzip >/dev/null 2>&1 || return 1
                     unzip -qq -o "${1}" -d "${3}" 2>/dev/null ;;
        raw|*)       cp "${1}" "${3}/${4:-program}" && chmod 755 "${3}/${4:-program}" ;;
    esac
}

_find_program() {
    #$1 => store directory, $2 => name asked for. A tarball puts its program
    #somewhere of its choosing, so it is looked for rather than assumed
    [ -x "${1}/${2}" ] && { printf "%s\\n" "${1}/${2}"; return 0; }

    _find_program__hit="$(find "${1}" -type f -name "${2}" -perm -u+x 2>/dev/null | head -1)"
    [ -n "${_find_program__hit}" ] && { printf "%s\\n" "${_find_program__hit}"; return 0; }

    #exactly one executable and no ambiguity about which one it is
    _find_program__all="$(find "${1}" -type f -perm -u+x 2>/dev/null)"
    if [ X"$(printf "%s\\n" "${_find_program__all}" | awk 'NF{n++} END{print n+0}')" = X"1" ]; then
        printf "%s\\n" "${_find_program__all}"
        return 0
    fi
    return 1
}

_fetch_verified() {
    #$1 => url, $2 => the sha256 published for it, or nothing. Leaves the file
    #in fetched and its digest in fetched_digest. Everything static-run fetches
    #itself goes through here: what a tool fetches is the tool's to check
    fetched="${home}/tmp/artifact.$$"; fetched_digest=""
    _mkdir_p "${home}/tmp" || return 1
    rm -rf "${fetched}" "${fetched}.d"

    _verbose "${PROGNAME}: fetching ${1}"
    _retriever "${1}" "${fetched}" || {
        rm -f "${fetched}"
        _say "${PROGNAME}: could not fetch ${1}"
        return 1
    }

    fetched_digest="$(_digest "${fetched}")" || {
        rm -f "${fetched}"
        _say "${PROGNAME}: no sha256 program here, cannot name what was downloaded"
        return 1
    }

    #verification is a badge and not a gate, with one exception: a checksum
    #that was published and does not match is not a missing badge, it is a
    #different file from the one the project meant to serve
    if [ -n "${2}" ] && [ X"${2}" != X"${fetched_digest}" ]; then
        rm -f "${fetched}"
        _say "${PROGNAME}: published checksum does not match what arrived"
        _say "${PROGNAME}: wanted ${2}"
        _say "${PROGNAME}: got    ${fetched_digest}"
        return 1
    fi
}

_channel_home() {
    #$1 => channel. Everything a channel has here lives under one directory:
    #its catalog, its tool, what the tool installed, launchers, caches and
    #records. Removing that directory removes the channel and nothing else, and
    #nothing outside it breaks: a remembered decision that pointed in there is
    #simply made again
    printf "%s\\n" "${home}/channels/${1}"
}

_place() {
    #$1 => channel, $2 => package, $3 => version, $4 => what locate answered.
    #Nothing is placed under its final name until its digest is known, so an
    #interrupted download leaves rubbish in one sweepable place and never
    #something that looks installed
    _place__ch="${1}"; _place__pkg="${2}"; _place__ver="${3}"; _place__info="${4}"
    _place__home="$(_channel_home "${_place__ch}")"

    _place__url="$(printf "%s\\n"    "${_place__info}" | awk -F= '$1=="url"{sub(/^url=/,""); print; exit}')"
    _place__format="$(printf "%s\\n" "${_place__info}" | awk -F= '$1=="format"{print $2; exit}')"
    _place__bin="$(printf "%s\\n"    "${_place__info}" | awk -F= '$1=="bin"{print $2; exit}')"
    _place__sha="$(printf "%s\\n"    "${_place__info}" | awk -F= '$1=="sha256"{print $2; exit}')"
    [ -z "${_place__url}" ] && return 1
    [ -z "${_place__bin}" ] && _place__bin="${_place__pkg##*/}"

    _place__t0="$(_now_ms)"
    _fetch_verified "${_place__url}" "${_place__sha}" || return 1
    _place__art="${fetched}"; _place__digest="${fetched_digest}"
    _timing_add "${_place__ch}" "fetch" "$(wc -c < "${_place__art}" | awk '{print $1}')" "$(( $(_now_ms) - _place__t0 ))"

    _place__store="${_place__home}/store/${_place__digest}"
    if [ ! -d "${_place__store}" ]; then
        _unpack "${_place__art}" "${_place__format}" "${_place__art}.d" "${_place__bin}" || {
            rm -rf "${_place__art}" "${_place__art}.d"
            _say "${PROGNAME}: could not unpack the ${_place__format:-raw} artifact"
            return 1
        }
        _mkdir_p "${_place__home}/store" || return 1
        mv "${_place__art}.d" "${_place__store}" 2>/dev/null || {
            rm -rf "${_place__art}" "${_place__art}.d"
            return 1
        }
    fi
    rm -f "${_place__art}"

    #the link tree keeps the model the proposal got right: removing a
    #placement is removing a link, and the store is collected afterwards
    _place__link="${_place__home}/by/${_place__pkg}/${_place__ver}"
    _mkdir_p "${_place__link%/*}" || return 1
    rm -f "${_place__link}"
    ln -s "${_place__store}" "${_place__link}" 2>/dev/null

    _place__badge="none"
    [ -n "${_place__sha}" ] && _place__badge="verified"
    printf "%s\\t%s\\t%s\\t%s\\t%s\\n" "$(date +%Y-%m-%dT%H:%M:%S)" \
        "${_place__ch}:${_place__pkg}@${_place__ver}" "${_place__digest}" \
        "${_place__badge}" "${_place__url}" >> "${_place__home}/inventory"

    printf "%s\\n" "${_place__store}"
}

_tool_here() {
    #$1 => channel. Prints the tool it installs through when the tool is here
    _th__link="$(_channel_home "${1}")/tool/current"
    [ -x "${_th__link}" ] || return 1
    printf "%s\\n" "${_th__link}"
}

_tool_version() {
    #$1 => channel. The version of the tool current points at
    _tv__home="$(_channel_home "${1}")"
    _tv__target="$(readlink "${_tv__home}/tool/current" 2>/dev/null)" || return 1
    _tv__target="${_tv__target#${_tv__home}/tool/}"
    printf "%s\\n" "${_tv__target%%/*}"
}

_place_tool() {
    #$1 => the channel that installs through the tool, $2 => the tool's spec,
    #$3 => version, $4 => what locate answered. Prints the link it is reached
    #by. The tool is fetched and checked like anything static-run fetches, and
    #kept in the directory of the channel that uses it, one directory per
    #version with current pointing at the program. Launchers write current
    #down, so an update moves it and no launcher has to be rewritten
    _pt__home="$(_channel_home "${1}")"
    case "${3}" in
        ''|*/*|.|..|current) return 1 ;;
    esac
    _pt__url="$(printf "%s\\n"    "${4}" | awk -F= '$1=="url"{sub(/^url=/,""); print; exit}')"
    _pt__format="$(printf "%s\\n" "${4}" | awk -F= '$1=="format"{print $2; exit}')"
    _pt__bin="$(printf "%s\\n"    "${4}" | awk -F= '$1=="bin"{print $2; exit}')"
    _pt__sha="$(printf "%s\\n"    "${4}" | awk -F= '$1=="sha256"{print $2; exit}')"
    [ -z "${_pt__url}" ] && return 1
    if [ -z "${_pt__bin}" ]; then
        _pt__bin="$(_spec_package "${2}")"; _pt__bin="${_pt__bin##*/}"
    fi

    _pt__dir="${_pt__home}/tool/${3}"
    if [ ! -d "${_pt__dir}" ]; then
        _pt__t0="$(_now_ms)"
        _fetch_verified "${_pt__url}" "${_pt__sha}" || return 1
        _timing_add "${1}" "tool" "$(wc -c < "${fetched}" | awk '{print $1}')" "$(( $(_now_ms) - _pt__t0 ))"
        if ! _unpack "${fetched}" "${_pt__format}" "${fetched}.d" "${_pt__bin}"; then
            rm -rf "${fetched}" "${fetched}.d"
            _say "${PROGNAME}: could not unpack the ${_pt__format:-raw} artifact"
            return 1
        fi
        rm -f "${fetched}"
        _mkdir_p "${_pt__home}/tool" && mv "${fetched}.d" "${_pt__dir}" 2>/dev/null || {
            rm -rf "${fetched}.d"
            return 1
        }
        _pt__badge="none"; [ -n "${_pt__sha}" ] && _pt__badge="verified"
        printf "%s\\t%s\\t%s\\t%s\\t%s\\n" "$(date +%Y-%m-%dT%H:%M:%S)" \
            "${2}@${3}" "${fetched_digest}" "${_pt__badge}" "${_pt__url}" >> "${_pt__home}/inventory"
    fi
    _pt__prog="$(_find_program "${_pt__dir}" "${_pt__bin}")" || return 1
    _pt__link="${_pt__home}/tool/current"
    if [ X"$(readlink "${_pt__link}" 2>/dev/null)" != X"${_pt__prog}" ]; then
        rm -f "${_pt__link}.$$"
        ln -s "${_pt__prog}" "${_pt__link}.$$" 2>/dev/null && \
            mv -f "${_pt__link}.$$" "${_pt__link}" || return 1
    fi
    printf "%s\\n" "${_pt__link}"
}

###############################################################################
################################ cache ########################################
###############################################################################

_cache_key() {
    printf "%s\\n" "${1}" | tr '/:@' '___'
}

_cache_get() {
    _cache_get__f="${home}/cache/$(_cache_key "${1}")"
    [ -f "${_cache_get__f}" ] || return 1
    cat "${_cache_get__f}"
}

_cache_put() {
    _mkdir_p "${home}/cache" || return 0
    printf "%s\\n" "${2}" > "${home}/cache/$(_cache_key "${1}")"
}

###############################################################################
############################## list and purge #################################
###############################################################################

_list() {
    [ -d "${home}/channels" ] || { _say "${PROGNAME}: nothing placed yet"; return 0; }

    for _list__home in "${home}"/channels/*; do
        [ -d "${_list__home}" ] || continue
        _list__ch="${_list__home##*/}"
        _list__kind="$(_channel_meta "${_list__ch}" confines | awk '{print ($0=="yes") ? "confined" : "native"}')"
        if [ -L "${_list__home}/tool/current" ]; then
            _list__size="$(du -sk "${_list__home}/tool" 2>/dev/null | awk '{print $1*1024; exit}')"
            printf "  %-34s %10s  %s\\n" "${_list__ch}, its tool, $(_tool_version "${_list__ch}")" \
                "$(_human "${_list__size}")" "tool"
        fi
        find "${_list__home}/by" -type l 2>/dev/null | sort | while read -r _list__link; do
            _list__rest="${_list__link#${_list__home}/by/}"
            _list__ver="${_list__rest##*/}"
            _list__pkg="${_list__rest%/*}"
            [ -n "${1}" ] && case "${_list__pkg}" in *"${1}"*) ;; *) continue ;; esac

            _list__store="$(readlink "${_list__link}" 2>/dev/null)"
            _list__size="$(du -sk "${_list__store}" 2>/dev/null | awk '{print $1*1024; exit}')"
            #what a tool installed is what it holds for the package, not the
            #launcher the link names
            _list__plan="${_list__home}/members/${_list__pkg}/${_list__ver}"
            if [ -f "${_list__plan}" ]; then
                _list__size="$(while read -r _list__m; do
                        du -sk "${_list__home}/${_list__m}" 2>/dev/null
                    done < "${_list__plan}" | awk '{t += $1} END {print t*1024}')"
            fi
            printf "  %-34s %10s  %s\\n" "${_list__ch}:${_list__pkg}@${_list__ver}" \
                "$(_human "${_list__size}")" "${_list__kind}"
        done
    done
}

_purge() {
    if [ -z "${1}" ]; then
        _confirm "${PROGNAME}: remove ${home} entirely?" || return 1
        rm -rf "${home}"
        _say "${PROGNAME}: removed ${home}"
        return 0
    fi

    _purge__ch="$(_spec_channel "${1}")"
    _purge__pkg="$(_spec_package "${1}")"
    _purge__ver="$(_spec_version "${1}")"
    _purge__gone="0"
    _purge__target="$(_cache_get "${1}" 2>/dev/null)" || _purge__target=""
    #what the cached program was placed as: its store entry, or for what a tool
    #installed, the directory the placement links to. A name that is not the
    #package's - rg for ripgrep, curl for curl.se - is found that way
    case "${_purge__target}" in
        "${home}/channels/"*/store/*)
            _purge__rest="${_purge__target#${home}/channels/}"
            _purge__tch="${_purge__rest%%/*}"; _purge__rest="${_purge__rest#*/store/}"
            _purge__target="${home}/channels/${_purge__tch}/store/${_purge__rest%%/*}" ;;
        "${home}/channels/"*/*) _purge__target="${_purge__target%/*}" ;;
        *) _purge__target="" ;;
    esac
    _mkdir_p "${home}/tmp" || return 1
    _purge__members="${home}/tmp/purged.$$"; rm -f "${_purge__members}"

    for _purge__home in "${home}"/channels/*; do
        [ -d "${_purge__home}/by" ] || continue
        _purge__lch="${_purge__home##*/}"
        [ -n "${_purge__ch}" ] && [ X"${_purge__ch}" != X"${_purge__lch}" ] && continue

        for _purge__link in $(find "${_purge__home}/by" -type l 2>/dev/null | sort); do
            _purge__rest="${_purge__link#${_purge__home}/by/}"
            _purge__lver="${_purge__rest##*/}"
            _purge__lpkg="${_purge__rest%/*}"

            [ -n "${_purge__ver}" ] && [ X"${_purge__ver}" != X"${_purge__lver}" ] && continue
            #a bare name matches the repository it resolved to: jq purges
            #jqlang/jq, and rg purges whichever rg was chosen to mean
            if [ X"${_purge__pkg}" != X"${_purge__lpkg}" ] && \
               [ X"${_purge__pkg}" != X"${_purge__lpkg##*/}" ]; then
                [ -n "${_purge__target}" ] || continue
                [ X"$(readlink "${_purge__link}" 2>/dev/null)" = X"${_purge__target}" ] || continue
            fi

            #a placement a tool installed goes with its launcher and its
            #record, and what the tool holds for it is collected below once no
            #other placement of the same channel names it
            _purge__plan="${_purge__home}/members/${_purge__lpkg}/${_purge__lver}"
            if [ -f "${_purge__plan}" ]; then
                awk -v h="${_purge__home}" 'NF {printf("%s\t%s\n", h, $0)}' "${_purge__plan}" >> "${_purge__members}"
                rm -f "${_purge__plan}"
                case "$(readlink "${_purge__link}" 2>/dev/null)" in
                    "${_purge__home}/run/"?*) rm -rf "$(readlink "${_purge__link}")" ;;
                esac
            fi
            rm -f "${_purge__link}"
            _purge__gone="$((${_purge__gone} + 1))"
        done
    done

    [ X"${_purge__gone}" = X"0" ] && { rm -f "${_purge__members}"; _say "${PROGNAME}: nothing matched '${1}'"; return 1; }

    _purge__kept="0"; _purge__freed="0"
    #what a tool installed outlives its placement only until no other placement
    #names it: curl and git share an openssl
    if [ -f "${_purge__members}" ]; then
        LC_ALL=C sort -u "${_purge__members}" > "${_purge__members}.u"
        while IFS='	' read -r _purge__mh _purge__m; do
            case "${_purge__m}" in
                ''|*..*|/*) continue ;;
            esac
            if [ -d "${_purge__mh}/members" ] && \
               find "${_purge__mh}/members" -type f -exec cat {} + 2>/dev/null | grep -Fx "${_purge__m}" >/dev/null; then
                _purge__kept="$((${_purge__kept} + 1))"
                continue
            fi
            [ -d "${_purge__mh}/${_purge__m}" ] || continue
            _purge__size="$(du -sk "${_purge__mh}/${_purge__m}" 2>/dev/null | awk '{print $1*1024; exit}')"
            _purge__freed="$((${_purge__freed} + ${_purge__size:-0}))"
            rm -rf "${_purge__mh}/${_purge__m}"
            #a tool keeps links beside what it installs - pkgx points v1 and v*
            #at a version - and once that is gone they point nowhere. Those go
            #too, and then every directory the removal left empty
            _purge__d="${_purge__mh}/${_purge__m%/*}"
            for _purge__l in "${_purge__d}"/* "${_purge__d}"/.[!.]*; do
                [ -L "${_purge__l}" ] && [ ! -e "${_purge__l}" ] && rm -f "${_purge__l}"
            done
            while [ X"${_purge__d}" != X"${_purge__mh}" ] && rmdir "${_purge__d}" 2>/dev/null; do
                _purge__d="${_purge__d%/*}"
            done
        done < "${_purge__members}.u"
        rm -f "${_purge__members}.u"
    fi
    rm -f "${_purge__members}"

    #a store entry outlives the link that named it only until nobody else
    #points at it, which is what content addressing buys
    for _purge__dir in "${home}"/channels/*/store/*; do
        [ -d "${_purge__dir}" ] || continue
        _purge__sh="${_purge__dir%/store/*}"
        if find "${_purge__sh}/by" -type l -lname "${_purge__dir}" 2>/dev/null | \
           awk 'NF{n++} END{exit !(n+0)}'; then
            _purge__kept="$((${_purge__kept} + 1))"
        else
            _purge__size="$(du -sk "${_purge__dir}" 2>/dev/null | awk '{print $1*1024; exit}')"
            _purge__freed="$((${_purge__freed} + ${_purge__size:-0}))"
            rm -rf "${_purge__dir}"
        fi
    done

    rm -f "${home}/cache/$(_cache_key "${1}")"
    _say "${PROGNAME}: removed ${_purge__gone} placement(s), freed $(_human "${_purge__freed}"), ${_purge__kept} still referenced"
}

###############################################################################
############################## indexes and apropos ############################
###############################################################################

_index_one() {
    #$1 => channel. Refreshes its catalog and says what came of it. Answers 0
    #when it did, 1 when it could not, and 2 for a channel that keeps none
    _io__t0="$(_now_ms)"
    _io__out="$("$(_channels_dir)/${1}" index 2>/dev/null)"
    case "${?}" in
        0)  _timing_add "${1}" "index" "$(printf "%s\\n" "${_io__out}" | \
                awk -F= '$1 == "bytes" {print $2; exit}')" "$(( $(_now_ms) - _io__t0 ))"
            _say "${PROGNAME}: ${1}: $(printf "%s\\n" "${_io__out}" | \
                awk -F= 'NF == 2 && $1 != "bytes" {printf("%s%s %s", (n++ ? ", " : ""), $2, $1)}')"
            return 0 ;;
        2)  _say "${PROGNAME}: ${1}: not updated, $(printf "%s\\n" "${_io__out}" | \
                awk '/^unreachable=/ {sub(/^unreachable=/, ""); print; exit}')"
            return 1 ;;
    esac
    return 2
}

_manager_update() {
    #$1 => channel, $2 => the spec of the tool it installs through. A tool that
    #is here is brought to its newest release: fetched and checked like
    #anything else static-run fetches, current moved to it, and the old one
    #removed. A tool not fetched yet is left for the first time it is needed,
    #which is when its cost can be asked about
    _mu__name="$(_spec_package "${2}")"; _mu__name="${_mu__name##*/}"
    if ! _tool_here "${1}" >/dev/null; then
        _say "${PROGNAME}: ${1}: ${_mu__name} is not here yet, it is fetched the first time ${1} is needed"
        return 0
    fi
    _mu__ch="$(_spec_channel "${2}")"; _mu__pkg="$(_spec_package "${2}")"
    _mu__probed="$(STATIC_RUN_REFRESH="1"; export STATIC_RUN_REFRESH; _probe_all "${_mu__pkg}" "" "${_mu__ch}")"
    _mu__line="$(printf "%s\\n" "${_mu__probed}" | awk 'NF && $1 !~ /^~/' | head -1)"
    if [ -z "${_mu__line}" ]; then
        _say "${PROGNAME}: ${1}: ${_mu__name} could not be checked for a newer release: $(printf "%s\\n" "${_mu__probed}" | \
            awk '$1 == "~unreachable" {$1 = ""; $2 = ""; sub(/^ +/, ""); print; exit}')"
        return 1
    fi
    _mu__ver="$(printf "%s\\n" "${_mu__line}" | awk '{print $3}')"
    _mu__old="$(_tool_version "${1}")"
    if [ X"${_mu__old}" = X"${_mu__ver}" ]; then
        _say "${PROGNAME}: ${1}: ${_mu__name} ${_mu__ver} is the newest"
        return 0
    fi
    _mu__info="$("$(_channels_dir)/${_mu__ch}" locate "${_mu__pkg}" "${_mu__ver}" 2>/dev/null)" || _mu__info=""
    _say "${PROGNAME}: ${1}: ${_mu__name} ${_mu__old} -> ${_mu__ver}, $(_human "$(printf "%s\\n" "${_mu__line}" | awk '{print $4}')")"
    if [ -z "${_mu__info}" ] || ! _place_tool "${1}" "${2}" "${_mu__ver}" "${_mu__info}" >/dev/null; then
        _say "${PROGNAME}: ${1}: ${_mu__name} ${_mu__ver} could not be placed, the one here stays"
        return 1
    fi
    for _mu__d in "$(_channel_home "${1}")"/tool/*; do
        [ -d "${_mu__d}" ] && [ ! -L "${_mu__d}" ] || continue
        [ X"${_mu__d##*/}" = X"${_mu__ver}" ] && continue
        rm -rf "${_mu__d}"
    done
    return 0
}

_index_update() {
    #$1 => a channel, or nothing for all of them. Brings each catalog up to
    #date, and the tool each channel installs through; with a channel named,
    #that channel's and nobody else's
    _iu__only=""
    if [ -n "${1}" ]; then
        _iu__only="${1}"
        if [ ! -x "$(_channels_dir)/${_iu__only}" ]; then
            _iu__only="$(_channel_by_alias "${1}")" || {
                _say "${PROGNAME}: no channel called '${1}'"
                return 1
            }
        fi
    fi
    _iu__any=""; _iu__failed=""
    for _iu__c in $(_channels); do
        [ -n "${_iu__only}" ] && [ X"${_iu__c}" != X"${_iu__only}" ] && continue
        _index_one "${_iu__c}"
        case "${?}" in
            0) _iu__any="1" ;;
            1) _iu__any="1"; _iu__failed="1" ;;
        esac
        _iu__m="$(_channel_meta "${_iu__c}" manager)"
        if [ -n "${_iu__m}" ]; then
            _iu__any="1"
            _manager_update "${_iu__c}" "${_iu__m}" || _iu__failed="1"
        fi
    done
    if [ -z "${_iu__any}" ]; then
        if [ -n "${_iu__only}" ]; then
            _say "${PROGNAME}: ${_iu__only} keeps no index and installs through no tool"
        else
            _say "${PROGNAME}: no channel keeps an index"
        fi
    fi
    [ -z "${_iu__failed}" ]
}

_apropos() {
    #the answer comes from indexes on this machine, built from what catalogs
    #publish about themselves, and never from a search engine: a tool in this
    #repository once leaned on search engines, two went away, and so did it
    [ -z "${1}" ] && _die "${PROGNAME}: --apropos needs something to look for"
    _ap__found=""
    for _ap__c in $(_channels); do
        _ap__out="$("$(_channels_dir)/${_ap__c}" search "${@}" 2>/dev/null)"
        case "${?}" in
            0)  [ -z "${_ap__out}" ] && continue
                _ap__found="1"
                _ap__kind="$(_channel_meta "${_ap__c}" confines | awk '{print ($0=="yes") ? "confined" : "native"}')"
                printf "%s\\n" "${_ap__out}" | awk -F'\t' -v k="${_ap__kind}" \
                    'NF {printf("  %-36s %-8s %s\n", $1, k, $3)}' ;;
            2)  _say "${PROGNAME}: ${_ap__c} could not be searched: $(printf "%s\\n" "${_ap__out}" | \
                    awk '/^unreachable=/ {sub(/^unreachable=/, ""); print; exit}')" ;;
        esac
    done
    if [ -n "$(find "${home}/channels" -path '*/index/*' -type f -mtime +7 2>/dev/null)" ]; then
        _say "${PROGNAME}: an index is more than a week old, --index-update refreshes it"
    fi
    [ -n "${_ap__found}" ] || { _say "${PROGNAME}: nothing matched '${*}'"; return 1; }
}

###############################################################################
################################### update ####################################
###############################################################################

_update() {
    _u__current_file="$(cd "$(_realdir "${0}")" && pwd)/${PROGNAME}"

    if [ -L "${_u__current_file}" ]; then
        printf "%s\\n" "${PROGNAME}: ${_u__current_file} is a link, update its repository instead" >&2
        return 1
    fi

    _u__remote="$(_retriever "${SRC_URL}${PROGNAME}")" || return 1
    _u__remote_version="$(printf "%s\\n" "${_u__remote}" | \
        awk -F'"' '/^VERSION=/ {print $2; exit}')"
    [ -z "${_u__remote_version}" ] && return 1

    if [ X"${_u__remote_version}" = X"${VERSION}" ]; then
        _say "${PROGNAME} is already up to date"
        return 0
    fi

    printf "%s\\n" "${_u__remote}" > "${_u__current_file}" || return 1
    chmod 755 "${_u__current_file}"
    _say "${PROGNAME}: updated to ${_u__remote_version}"
}

###############################################################################
#################################### main #####################################
###############################################################################

PROGNAME="$(expr "${0}" : '.*/\([^/]*\)')"
[ -z "${PROGNAME}" ] && PROGNAME="static-run"

#options are read only until the spec appears. Everything after it belongs to
#the program being run: 'static-run github:jqlang/jq --version' asks jq for
#version, not this program for its own
while [ "${#}" -gt "0" ]; do
    case "${1}" in
        -h|--help)      _usage; exit 0 ;;
        -V|--version)   printf "%s\\n" "${PROGNAME} ${VERSION}"; exit 0 ;;
        -v|--verbose)   verbose="1";   shift ;;
        -q|--quiet)     quiet="1";     shift ;;
        -n|--dry-run)   dry_run="1";   shift ;;
        -y|--yes)       assume_yes="1"; shift ;;
        -L|--latest)    latest="1"; STATIC_RUN_REFRESH="1"; export STATIC_RUN_REFRESH; shift ;;
        -e|--ephemeral) ephemeral="1"; shift ;;
        -l|--list)      list="1";      shift ;;
        -i|--index-update) index_update="1"; shift ;;
        -a|--apropos)   apropos="1";   shift ;;
        -b|--bin)       shift; bin_name="${1}"; [ -n "${1}" ] && shift ;;
        --bin=*)        bin_name="${1#--bin=}"; shift ;;
        -p|--purge)     purge="1";     shift ;;
        -U|--update)    do_update="1"; shift ;;
        --)             shift; break ;;
        -*)             _die "${PROGNAME}: unrecognized option '${1}'" ;;
        *)              break ;;
    esac
done

if [ -n "${ephemeral}" ]; then
    STATIC_RUN_HOME="$(mktemp -d 2>/dev/null)" || \
        _die "${PROGNAME}: could not make a throwaway root"
    export STATIC_RUN_HOME
    trap 'rm -rf "${STATIC_RUN_HOME}"' EXIT HUP INT TERM
fi

home="$(_home)"
export STATIC_RUN_HOME="${home}"

[ -n "${do_update}" ] && { _update; exit "${?}"; }
[ -n "${index_update}" ] && { _index_update "${1}"; exit "${?}"; }
[ -n "${apropos}" ]   && { _apropos "${@}"; exit "${?}"; }
[ -n "${list}" ]      && { _list "${1}"; exit 0; }
[ -n "${purge}" ]     && { _purge "${1}"; exit "${?}"; }

[ -z "${1}" ] && _die "${PROGNAME}: nothing asked for"

spec="${1}"; shift
asked="${spec}"
channel="$(_spec_channel "${spec}")"
package="$(_spec_package "${spec}")"
version="$(_spec_version "${spec}")"

[ -z "${package}" ] && _die "${PROGNAME}: '${spec}' names no package"

#the program that was asked for, which a channel is told whenever it is asked
#where something lives or to install it: a package with several programs is
#otherwise run by some other name, and typing wat2wasm ran spectest-interp,
#another program of the same package, with the user's arguments
want_bin="${bin_name:-${package##*/}}"

if [ -n "${channel}" ] && [ ! -x "$(_channels_dir)/${channel}" ]; then
    channel="$(_channel_by_alias "${channel}")" || {
        _say "${PROGNAME}: no channel called '$(_spec_channel "${spec}")'"
        exit 127
    }
    #the spec is rewritten to the channel's real name, so that two spellings
    #of the same request share one cached decision instead of racing to make
    #two of them
    spec="${channel}:${package}"
    [ -n "${version}" ] && spec="${spec}@${version}"
fi

#the cheapest answer first: one that was already decided costs no network at
#all, and the second run of a command has to be indistinguishable from having
#it installed
if [ -z "${latest}" ] && [ -z "${dry_run}" ]; then
    cached="$(_cache_get "${spec}")" || cached=""
    #the decision remembers the program itself, so a hit is an exec with no
    #search. A directory is what an older decision remembered, and still works
    if [ -n "${cached}" ] && [ -f "${cached}" ] && [ -x "${cached}" ]; then
        exec "${cached}" "${@}"
    elif [ -n "${cached}" ] && [ -d "${cached}" ]; then
        program="$(_find_program "${cached}" "${bin_name:-${package##*/}}")" && \
            exec "${program}" "${@}"
    fi
fi

probed="$(_probe_all "${package}" "${version}" "${channel}")"
candidates="$(printf "%s\\n" "${probed}" | awk 'NF && $1 !~ /^~/')"
unreachable="$(printf "%s\\n" "${probed}" | \
    awk '$1 == "~unreachable" {$1 = ""; sub(/^ /, ""); print}')"
ambiguous="$(printf "%s\\n" "${probed}" | \
    awk '$1 == "~ambiguous" {for (i = 3; i <= NF; i++) print $2 ":" $i}')"

if [ -n "${ambiguous}" ]; then
    #every program that answers to the name is offered, including one another
    #channel served outright, because the question is which program and not
    #which channel. The answer is remembered under the name that was typed
    choices="$( { printf "%s\\n" "${ambiguous}"
                  printf "%s\\n" "${candidates}" | awk 'NF {print $2 ":" $8}'; } | \
                awk 'NF && !seen[$0]++')"
    picked="$(_choose "${package}" "${choices}")" || {
        _say "${PROGNAME}: '${package}' is the name of more than one program, and none was guessed:"
        printf "%s\\n" "${choices}" | while read -r c_spec; do _say "    ${c_spec}"; done
        _say "${PROGNAME}: run one of them by its full name"
        exit 127
    }
    channel="${picked%%:*}"
    package="${picked#*:}"
    probed="$(_probe_all "${package}" "${version}" "${channel}")"
    candidates="$(printf "%s\\n" "${probed}" | awk 'NF && $1 !~ /^~/')"
    unreachable="$(printf "%s\\n" "${probed}" | \
        awk '$1 == "~unreachable" {$1 = ""; sub(/^ /, ""); print}')"
fi

if [ -z "${candidates}" ]; then
    #127 is the shell's word for "nothing ran", and the only status a caller
    #can tell apart from a program that ran and failed. What is said with it
    #has to be true, though: with a channel that could not be asked, nobody
    #knows whether the package exists, and saying it does not is a lie
    if [ -n "${unreachable}" ]; then
        printf "%s\\n" "${unreachable}" | while read -r u_ch u_why; do
            _say "${PROGNAME}: ${u_ch} could not be asked: ${u_why}"
        done
        _say "${PROGNAME}: so whether anything provides '${package}' is not known"
        exit 127
    fi
    _say "${PROGNAME}: no channel provides '${package}'"
    exit 127
fi

_winner() {
    winner="$(printf "%s\\n" "${candidates}" | head -1)"
    w_channel="$(printf  "%s\\n" "${winner}" | awk '{print $2}')"
    w_version="$(printf  "%s\\n" "${winner}" | awk '{print $3}')"
    w_bytes="$(printf    "%s\\n" "${winner}" | awk '{print $4}')"
    w_badge="$(printf    "%s\\n" "${winner}" | awk '{print $5}')"
    w_confines="$(printf "%s\\n" "${winner}" | awk '{print $6}')"
    w_package="$(printf  "%s\\n" "${winner}" | awk '{print $8}')"
    w_requires="$(printf "%s\\n" "${winner}" | awk '{print $9}')"
    w_estimate="$(printf "%s\\n" "${winner}" | awk '{print $10}')"
    w_marginal="$(printf "%s\\n" "${winner}" | awk '{print $11}')"
    w_ms="$(printf "%s\\n" "${winner}" | awk '{print $12}')"
    [ -z "${w_package}" ] && w_package="${package}"
    [ X"${w_requires}" = X"-" ] && w_requires=""
    [ X"${w_estimate}" = X"-" ] && w_estimate=""
    w_kind="native"
    [ X"${w_confines}" = X"yes" ] && w_kind="confined"
}
_winner

#a winner that installs through a tool of its own needs that tool, and keeping
#those tools present and up to date is this program's job. A tool already here
#is reused; otherwise it is looked up now, so its cost is part of the question
#and not a surprise after it
_tool_for_winner() {
    req_program=""; req_channel=""; req_package=""; req_version=""; req_bytes=""; req_info=""; req_why=""
    [ -z "${w_requires}" ] && return 0
    req_program="$(_tool_here "${w_channel}")" && return 0
    req_channel="$(_spec_channel "${w_requires}")"
    req_package="$(_spec_package "${w_requires}")"
    req_probed="$(_probe_all "${req_package}" "" "${req_channel}")"
    req_why="$(printf "%s\\n" "${req_probed}" | awk '$1 == "~unreachable" {$1 = ""; $2 = ""; sub(/^ +/, ""); print; exit}')"
    req_line="$(printf "%s\\n" "${req_probed}" | awk 'NF && $1 !~ /^~/' | head -1)"
    [ -z "${req_line}" ] && return 1
    req_version="$(printf "%s\\n" "${req_line}" | awk '{print $3}')"
    req_bytes="$(printf   "%s\\n" "${req_line}" | awk '{print $4}')"
    req_info="$("$(_channels_dir)/${req_channel}" locate "${req_package}" "${req_version}" 2>/dev/null)" || req_info=""
    [ -n "${req_info}" ]
}

#when the tool cannot be had, the reason is said - a rate limit is not a
#missing package, and saying "nothing provides" there was a lie this program
#told once already - and the channels are asked again with that tool left out:
#the same channel may still manage the old way, and another may answer
_without_tool() {
    if [ -n "${req_why}" ]; then
        _say "${PROGNAME}: ${w_requires} could not be fetched: ${req_why}"
    else
        _say "${PROGNAME}: ${w_requires} could not be had"
    fi
    STATIC_RUN_NO_MANAGER="${STATIC_RUN_NO_MANAGER:+${STATIC_RUN_NO_MANAGER} }${w_channel}"
    export STATIC_RUN_NO_MANAGER
    _wt__lost="${w_channel}"
    candidates="$(_probe_all "${package}" "${version}" "${channel}" | awk 'NF && $1 !~ /^~/')"
    if [ -z "${candidates}" ]; then
        if [ -n "${req_why}" ]; then
            _say "${PROGNAME}: so whether anything provides '${package}' is not known"
        else
            _say "${PROGNAME}: and without it, nothing provides '${package}'"
        fi
        return 1
    fi
    _winner
    _say "${PROGNAME}: ${_wt__lost} goes without it; ${w_channel}:${w_package} instead"
}

while ! _tool_for_winner; do
    _without_tool || exit 127
done

if [ -n "${dry_run}" ]; then
    #inspecting is the one time it is worth asking every candidate where its
    #artifact lives, because that answer is also its badge, and a badge is
    #most of what someone inspecting came to find out
    printf "%s\\n" "${package##*/}"
    #quickest by the time it should take here, the tool to install through
    #included
    quickest="$(printf "%s\\n" "${candidates}" | awk '{print $12}' | \
        awk 'BEGIN{m=""} /^[0-9]+$/ {if (m=="" || $1<m) m=$1} END{print m}')"

    printf "%s\\n" "${candidates}" | while read -r d_key d_ch d_ver d_by d_bg d_cf d_de d_pkg d_req d_est d_total d_ms; do
        d_kind="native"; [ X"${d_cf}" = X"yes" ] && d_kind="confined"
        if [ X"${d_req}" != X"-" ]; then
            #what a tool installs, the tool answers for
            d_bg="via ${d_ch}"
        else
            d_info="$("$(_channels_dir)/${d_ch}" locate "${d_pkg}" "${d_ver}" "${want_bin}" 2>/dev/null)"
            case "${d_info}" in *'sha256='?*) d_bg="verified" ;; esac
        fi
        d_mark=""
        [ X"${d_ch}" = X"${w_channel}" ] && [ X"${d_ver}" = X"${w_version}" ] && d_mark="  <- elegido"
        d_size="$(_human "${d_by}")"; [ X"${d_est}" = X"yes" ] && d_size="~${d_size}"
        printf "  %-32s %10s %8s  %-8s  [%s]%s\\n" \
            "${d_ch}:${d_pkg}@${d_ver}" "${d_size}" "$(_human_us "${d_ms}")" "${d_kind}" "${d_bg}" "${d_mark}"
    done

    [ -n "${unreachable}" ] && printf "%s\\n" "${unreachable}" | while read -r u_ch u_why; do
        _say "  ${u_ch}: could not be asked, ${u_why}"
    done

    if [ -n "${w_requires}" ] && [ -z "${req_program}" ]; then
        printf "  %-32s %10s  %s\\n" "+ ${w_requires}@${req_version}" "$(_human "${req_bytes}")" "needed once, to install through"
    fi

    reason="${w_kind}"
    [ X"${w_kind}" = X"native" ] && reason="nativo"
    [ X"${w_kind}" = X"confined" ] && reason="confinado"
    if [ X"${w_ms}" = X"${quickest}" ]; then
        reason="${reason}, el más rápido"
    else
        reason="${reason}, aunque no el más rápido"
    fi
    printf "elegido: %s:%s@%s   motivo: %s\\n" "${w_channel}" "${w_package}" "${w_version}" "${reason}"
    exit 0
fi

#asking where the artifact lives is how the program's name becomes known, and
#for what static-run fetches itself, its badge as well; both are part of what
#the user is being asked to agree to, so it happens before the question
info="$("$(_channels_dir)/${w_channel}" locate "${w_package}" "${w_version}" "${want_bin}" 2>/dev/null)"
if [ "${?}" -eq "2" ]; then
    _say "${PROGNAME}: ${w_channel} could not be asked where '${package}' lives: $(printf "%s\\n" "${info}" | \
        awk '/^unreachable=/ {sub(/^unreachable=/, ""); print; exit}')"
    exit 127
fi
if [ -z "${info}" ]; then
    _say "${PROGNAME}: ${w_channel} knows '${package}' but cannot say where it lives"
    exit 127
fi
case "${info}" in
    *'sha256='?*) w_badge="verified" ;;
    *) w_badge="none" ;;
esac
#what a tool installs, the tool downloads and the tool checks, or does not.
#This program cannot tell which, so it says who answers for it and claims
#nothing: verified is only ever said of what static-run fetched itself
[ -n "${w_requires}" ] && w_badge="via ${w_channel}"

w_bin="$(printf "%s\\n" "${info}" | awk -F= '$1=="bin"{print $2; exit}')"
[ -z "${w_bin}" ] && w_bin="${w_package##*/}"

#the line names the repository and not only the word typed: a catalog that
#maps a name somewhere unexpected is caught here, by a person, or not at all
w_size="$(_human "${w_bytes}")"; [ -n "${w_estimate}" ] && w_size="about ${w_size}"
w_step="fetch"; [ -n "${w_requires}" ] && w_step="install"
w_step_ms="$(_est_us "${w_bytes}" "${w_channel}" "${w_step}")"
_say "${PROGNAME}: ${w_bin} ${w_version} -> ${w_channel}:${w_package}  ${w_size}, $(_human_us "${w_step_ms}")  [${w_badge}]  ${w_kind}"
[ -n "${unreachable}" ] && printf "%s\\n" "${unreachable}" | while read -r u_ch u_why; do
    _say "            (${u_ch} could not be asked, a quicker path may exist: ${u_why})"
done
if [ -n "${w_requires}" ] && [ -z "${req_program}" ]; then
    req_ms="$(_est_us "${req_bytes}" "${w_channel}" "tool")"
    _say "            first ${w_requires} ${req_version}, $(_human "${req_bytes}"), $(_human_us "${req_ms}"), fetched once and kept up to date"
    #what is being agreed to is the sum of the two, so the sum is written out
    #rather than left for the reader to add up. Unknown plus anything is
    #unknown, and an estimate plus anything is still an estimate
    w_total="unknown"
    case "${w_bytes}" in
        ''|*[!0-9]*) ;;
        *) case "${req_bytes}" in
               ''|*[!0-9]*) ;;
               *) w_total="$(_human "$((${w_bytes} + ${req_bytes}))")"
                  [ -n "${w_estimate}" ] && w_total="about ${w_total}"
                  if _is_number "${w_step_ms}" && _is_number "${req_ms}"; then
                      w_total="${w_total}, $(_human_us "$((${w_step_ms} + ${req_ms}))")"
                  fi ;;
           esac ;;
    esac
    _say "            total ${w_total}"
fi

if [ -z "$(_cache_get "${spec}")" ]; then
    _confirm "${PROGNAME}: proceed?" || exit 127
fi

if [ -n "${w_requires}" ]; then
    if [ -z "${req_program}" ]; then
        #the path that was agreed to goes through this tool. If it cannot be
        #placed now, nothing else is fetched instead of it
        _say "${PROGNAME}: fetching ${req_package##*/} ${req_version}, to install ${w_package} with"
        req_program="$(_place_tool "${w_channel}" "${w_requires}" "${req_version}" "${req_info}")" || req_program=""
        if [ -z "${req_program}" ]; then
            _say "${PROGNAME}: ${w_requires} could not be placed, and nothing was installed"
            exit 127
        fi
    fi

    #the tool installs, and checks whatever it checks: that is its job. What
    #comes back is where the program is and what the tool holds for it
    _say "${PROGNAME}: ${w_channel} is installing ${w_package} ${w_version}"
    o_t0="$(_now_ms)"
    obtained="$(STATIC_RUN_REQUIRED="${req_program}" "$(_channels_dir)/${w_channel}" obtain \
        "${w_package}" "${w_version}" "${want_bin}")"
    o_rc="${?}"
    [ "${o_rc}" -eq "0" ] && _timing_add "${w_channel}" "install" "${w_bytes}" "$(( $(_now_ms) - o_t0 ))"
    if [ "${o_rc}" -ne "0" ]; then
        _say "${PROGNAME}: ${w_channel} could not install '${w_package}': $(printf "%s\\n" "${obtained}" | \
            awk -F= '$1=="failed" || $1=="unreachable" {sub(/^[a-z]+=/, ""); print; exit}')"
        exit 127
    fi
    program="$(printf "%s\\n" "${obtained}" | awk '/^program=/ {sub(/^program=/, ""); print; exit}')"
    o_asset="$(printf "%s\\n" "${obtained}" | awk '/^asset=/ {sub(/^asset=/, ""); print; exit}')"
    [ -x "${program}" ] || { _say "${PROGNAME}: ${w_channel} reported no program for '${w_package}'"; exit 127; }
    o_home="$(_channel_home "${w_channel}")"
    o_link="${o_home}/by/${w_package}/${w_version}"
    _mkdir_p "${o_link%/*}" && rm -f "${o_link}" && ln -s "${program%/*}" "${o_link}" 2>/dev/null
    #what the tool holds for this package, under the channel's directory and
    #nowhere else, so that purging it can take what no other placement uses
    o_members="$(printf "%s\\n" "${obtained}" | awk '/^member=/ {
        sub(/^member=/, "")
        if ($0 != "" && index($0, "..") == 0 && $0 !~ /^\// && $0 !~ /[^A-Za-z0-9._+\/-]/) print
    }')"
    if [ -n "${o_members}" ]; then
        o_record="${o_home}/members/${w_package}/${w_version}"
        _mkdir_p "${o_record%/*}" && printf "%s\\n" "${o_members}" > "${o_record}"
    fi
    printf "%s\\t%s\\t%s\\t%s\\t%s\\n" "$(date +%Y-%m-%dT%H:%M:%S)" \
        "${w_channel}:${w_package}@${w_version}" "-" "via ${w_channel}" \
        "${w_channel}:${o_asset}" >> "${o_home}/inventory"
else
    store="$(_place "${w_channel}" "${w_package}" "${w_version}" "${info}")" || exit 127
    program="$(_find_program "${store}" "${bin_name:-${w_bin}}")" || {
        _say "${PROGNAME}: nothing executable called '${bin_name:-${w_bin}}' inside the artifact"
        exit 127
    }
fi

#remembered under what was asked for, which for a bare name is the name: a
#choice between programs that share one is made once and not every time
_cache_put "${asked}" "${program}"
[ X"${asked}" != X"${spec}" ] && _cache_put "${spec}" "${program}"
exec "${program}" "${@}"
