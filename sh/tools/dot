#!/bin/sh
#description: git for the dotfiles repo, with $HOME as its work tree
#usage: dot [git command] [args]...

#example: dot status
#example: dot add .claude/settings.json && dot commit -m "claude: allow jq"

#refuses the commands whose blast radius is the whole home directory; the
#setup it expects is described in https://github.com/javier-lopez/dotfiles

_usage() {
    printf "%s\\n" "Usage: ${PROGNAME} [git command] [args]..."
    printf "%s\\n" "Run git on the dotfiles repo (~/.dotfiles.git) with \$HOME as its work tree."
    printf "\\n"
    printf "%s\\n" "  -h, --help   show this help message and exit"
    printf "\\n"
    printf "%s\\n" "Refused: clean, add -A/--all/., reset --hard, checkout -f, switch -f,"
    printf "%s\\n" "switch --discard-changes and --autostash on pull, merge or rebase."
}

_die() {
    [ -z "${1}" ] || printf "%s\\n" "${*}" >&2
    _usage >&2; exit 1
}

_refuse() {
    printf "%s\\n" "${PROGNAME}: refused: ${*}" >&2
    exit 1
}

PROGNAME="${0##*/}"

[ "${#}" -eq "0" ] && _die

case "${1}" in
    -h|--help) _usage && exit ;;
    clean) _refuse "'clean' deletes untracked files across \$HOME (ssh keys, non-repo dirs)" ;;
esac

for arg in "${@}"; do
    case "${1}:${arg}" in
        add:-A|add:--all|add:.)
            _refuse "'add ${arg}' stages every untracked dotfile; add explicit paths" ;;
        reset:--hard|checkout:-f|checkout:--force|switch:-f|switch:--force|switch:--discard-changes)
            _refuse "'${1} ${arg}' overwrites local dotfiles" ;;
        pull:--autostash|merge:--autostash|rebase:--autostash)
            _refuse "'--autostash' leaves conflict markers in live files" ;;
    esac
done

#run from $HOME: every cwd under ~ is inside the work tree, and git makes
#ls-files output and pathspecs relative to it (an empty ls-files once built an
#empty sparse pattern that dropped clean dotfiles). Paths are always ~-relative.
exec git -C "${HOME}" --git-dir="${HOME}/.dotfiles.git" --work-tree="${HOME}" "${@}"

