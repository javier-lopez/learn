###############################################################################

_mode() {
    [ -n "${mode}" ] && _die "${PROGNAME}: --check, --coverage and --reviewed are one at a time"
    mode="${1}"
}

#the arguments are read in one rotation: an option is taken and dropped, and
#anything else goes to the back. So --frozen is read wherever it is written, and
#--reviewed FILE FUNCTION --frozen is the sentence it reads like
args_left="${#}"
while [ "${args_left}" -gt "0" ]; do
    args_left="$((${args_left} - 1))"
    case "${1}" in
        -h|--help)     _usage; exit 0 ;;
        -V|--version)  printf "%s\\n" "${PROGNAME} ${VERSION}"; exit 0 ;;
        -U|--update)   _update; exit "${?}" ;;
        -c|--check)    _mode "check" ;;
        -o|--coverage) _mode "coverage" ;;
        -r|--reviewed) _mode "reviewed" ;;
        -f|--frozen)   state="frozen" ;;
        -y|--yes)      assume_yes="1" ;;
        -*)            _die "${PROGNAME}: unrecognized option '${1}'" ;;
        *)             set -- "${@}" "${1}" ;;
    esac
    shift
done

[ -z "${mode}" ] && _die "${PROGNAME}: say what to do: --check, --coverage or --reviewed"
[ -n "${state}" ] && [ X"${mode}" != X"reviewed" ] && \
    _die "${PROGNAME}: --frozen says how --reviewed writes a tag, and there is no --reviewed here"

root="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -z "${root}" ] && _die "${PROGNAME}: not inside a git repository, and a tag names a commit in one"

#a path is resolved where it was typed and then named the way the repository
#names it, because the commit a tag points at is asked about a path from the
#root. The tool moves there once, and every path from here is the repository's
if [ X"${mode}" = X"reviewed" ]; then
    [ "${#}" -eq "2" ] || _die "${PROGNAME}: --reviewed takes one file and one function"
    rfile="$(git ls-files --full-name -- "${1}" 2>/dev/null)"
    [ -z "${rfile}" ] && _die "${PROGNAME}: git tracks no '${1}', and a tag needs a commit to compare with"
    case "${rfile}" in
        *"
"*) _die "${PROGNAME}: '${1}' names more than one file" ;;
    esac
    rfunc="${2}"
    state="${state:-reviewed}"
    cd "${root}" || _die "${PROGNAME}: cannot reach ${root}"
    _reviewed "${rfile}" "${rfunc}"
    exit "${?}"
fi

paths=""
while [ "${#}" -gt "0" ]; do
    got="$(git ls-files --full-name -- "${1}" 2>/dev/null)"
    [ -z "${got}" ] && _die "${PROGNAME}: git tracks no '${1}', and a tag needs a commit to compare with"
    paths="${paths}${got}
"
    shift
done
cd "${root}" || _die "${PROGNAME}: cannot reach ${root}"

_sweep "${paths}"
