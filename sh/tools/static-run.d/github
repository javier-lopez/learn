#!/bin/sh
#description: static-run channel - a program published as a release asset on github
#usage: github meta | github probe OWNER/REPO [VER] | github locate OWNER/REPO VER
#probe and locate exit 0 with an answer, 1 when there is none, and 2 when
#github could not be asked, with the reason on an unreachable= line

#this is a channel, not a command. It never downloads and never installs: it
#answers what a package is called, what it weighs and where it lives, and the
#resolver does the fetching, the digest and the verification once, for all
#channels, which is the only way the badge can mean the same thing everywhere

API="https://api.github.com/repos"

#two settings, each doing one thing, both read from the environment because
#the shell hook that calls this cannot pass options:
#
#  STATIC_RUN_GITHUB_API=off     never ask api.github.com. Answers come only
#                                from what is already cached, and a package
#                                with nothing cached is reported as not asked,
#                                naming this setting. Downloading an asset or
#                                a checksum file is not the api and still works
#  STATIC_RUN_GITHUB_DIGEST=off  github's digest does not count as verification;
#                                only a checksum the project publishes does.
#                                It saves no request: the digest arrives in the
#                                same answer as the list of assets
_off() {
    case "${1}" in
        off|OFF|no|NO|0|false|FALSE) return 0 ;;
    esac
    return 1
}

_retrieve() {
    #a plain download, never authenticated: these urls redirect to storage
    #that is not github's api, and a token has no business travelling there
    if command -v "curl" >/dev/null 2>&1; then
        curl -fsSL "${1}"
    elif command -v "wget" >/dev/null 2>&1; then
        wget -q -O- "${1}"
    else
        return 1
    fi
}

_api() {
    #$1 => url, $2 => file for the body. Leaves the status in http_code, and
    #000 when nothing answered at all. A token the user exported under either
    #conventional name goes to the api and nowhere else, and it goes through
    #curl's config on stdin: on the command line any other account on this
    #machine could read it out of ps
    http_code=""
    _api__token="${GITHUB_TOKEN:-${GH_TOKEN}}"

    if command -v "curl" >/dev/null 2>&1; then
        http_code="$(
            {
                printf "%s\\n" 'header = "Accept: application/vnd.github+json"'
                [ -n "${_api__token}" ] && \
                    printf 'header = "Authorization: Bearer %s"\n' "${_api__token}"
            } | curl -sSL -K - -o "${2}" -w '%{http_code}' "${1}" 2>/dev/null
        )" || http_code="000"
    elif command -v "wget" >/dev/null 2>&1; then
        #wget cannot be handed a header except on its command line, so it asks
        #without a token and lives with sixty questions an hour
        http_code="$(wget -S -O "${2}" --header="Accept: application/vnd.github+json" \
            "${1}" 2>&1 | awk '/^ *HTTP\// {c = $2} END {print c}')"
    fi
    [ -z "${http_code}" ] && http_code="000"
}

_cache_file() {
    #probe and locate ask the same question a second apart, and the rate limit
    #for an unauthenticated caller is sixty questions an hour
    printf "%s\\n" "${STATIC_RUN_HOME:-/tmp}/tmp/github.$(printf "%s\\n" "${1}@${2}" | tr '/@' '__').json"
}

_fetch_release() {
    #$1 => owner/repo, $2 => version or empty for the latest one. Leaves the
    #release in release_file and answers 0 when there is one, 1 when github
    #says there is nothing there, and 2 when github could not be asked, with
    #the reason in why. Being told no and not being able to ask are different
    #answers, and a resolver that hears them as one says something false: this
    #channel was rate limited once and the user was told jq does not exist
    why=""
    release_file="$(_cache_file "${1}" "${2}")"

    #a tagged release never changes, so its answer is kept for good. "latest"
    #is a question whose answer moves: asked again after a day, and at once
    #when the resolver was told to look again
    if [ -s "${release_file}" ]; then
        [ -n "${2}" ] && return 0
        if [ -z "${STATIC_RUN_REFRESH}" ] && \
           [ -z "$(find "${release_file}" -mtime +0 2>/dev/null)" ]; then
            return 0
        fi
    fi

    #a release asked for by its tag may already be here as "latest", which is
    #the same release under its other name. The resolver asks by that tag
    #right after probe reported it, so reading it here makes one resolution
    #cost one request instead of two, and the limit that once said jq does not
    #exist stretches twice as far. It is decided when reading and not when
    #writing, so an answer cached any other way is found as well
    if [ -n "${2}" ]; then
        _fetch_release__latest="$(_cache_file "${1}" "")"
        if [ -s "${_fetch_release__latest}" ] && \
           [ X"$(_version_of < "${_fetch_release__latest}")" = X"${2}" ]; then
            release_file="${_fetch_release__latest}"
            return 0
        fi
    fi

    if [ -z "${2}" ]; then
        _fetch_release__url="${API}/${1}/releases/latest"
    else
        _fetch_release__url="${API}/${1}/releases/tags/${2}"
    fi

    #the api was switched off by the user: whatever is cached is the answer,
    #even a stale "latest", and with nothing cached that is said plainly
    if _off "${STATIC_RUN_GITHUB_API}"; then
        [ -s "${release_file}" ] && return 0
        why="STATIC_RUN_GITHUB_API=off and nothing about ${1} is cached"
        return 2
    fi

    mkdir -p "${release_file%/*}" 2>/dev/null
    _fetch_release__tmp="${release_file}.$$"
    _api "${_fetch_release__url}" "${_fetch_release__tmp}"

    case "${http_code}" in
        200)
            if grep '"assets"' "${_fetch_release__tmp}" >/dev/null 2>&1; then
                mv "${_fetch_release__tmp}" "${release_file}"
                return 0
            fi
            why="github answered with something that is not a release" ;;
        404)
            rm -f "${_fetch_release__tmp}"
            return 1 ;;
        403|429)
            case "$(awk -F'"' '/"message"/ {print $4; exit}' "${_fetch_release__tmp}" 2>/dev/null)" in
                *'rate limit'*)
                    why="the github api limit for this address is used up"
                    [ -z "${GITHUB_TOKEN}${GH_TOKEN}" ] && \
                        why="${why}, exporting GITHUB_TOKEN raises it from 60 to 5000 an hour" ;;
                *)  why="github refused the request with ${http_code}" ;;
            esac ;;
        000) why="api.github.com did not answer" ;;
        *)   why="github answered ${http_code}" ;;
    esac
    rm -f "${_fetch_release__tmp}"

    #an old answer is better than none, and yesterday's "latest" is still a
    #release that exists. Only with nothing at all to fall back on is the
    #failure to ask passed on
    [ -s "${release_file}" ] && return 0
    return 2
}

_platform() {
    case "$(uname -m 2>/dev/null)" in
        x86_64|amd64) printf "%s\\n" "x86_64|amd64|x64" ;;
        aarch64|arm64) printf "%s\\n" "aarch64|arm64" ;;
        *) printf "%s\\n" "$(uname -m 2>/dev/null)" ;;
    esac
}

_fields() {
    #the release, reduced to the two things this channel reads from it:
    #
    #    tag    <tag_name>
    #    asset  <name>  <size>  <browser_download_url>  <digest>
    #
    #It is a small json reader and not a pattern match, because the patterns
    #were each a promise about github's serializer that nobody made. Reading
    #line breaks broke on compact json. Reading fields in the order they came
    #took a nested object's "name" for the asset's own, and lost an asset whose
    #url came before its name. So strings are tracked as strings, depth is
    #counted, a field counts only at the depth of its own object, and an asset
    #is emitted when that object closes and not when some field arrives. It
    #agrees with jq on real releases and on releases built to break it
    awk '
        function unesc(v) {
            gsub(/\\\\/, "\001", v); gsub(/\\"/, "\"", v); gsub(/\\\//, "/", v)
            gsub("\001", "\\", v)
            return v
        }
        function take(opening,   s, k, rest, v) {
            s = seg; seg = ""
            if (s !~ /^[ \t\r]*"/) return
            sub(/^[ \t\r]*"/, "", s)
            k = s; sub(/".*$/, "", k)
            rest = s; sub(/^[^"]*"[ \t\r]*/, "", rest)
            if (rest !~ /^:/) return
            if (opening) { if (depth == 1) arrkey = k; return }
            sub(/^:[ \t\r]*/, "", rest); sub(/[ \t\r]+$/, "", rest)
            v = rest
            if (v ~ /^".*"$/) v = unesc(substr(v, 2, length(v) - 2))
            if (depth == 1 && k == "tag_name") print "tag\t" v
            if (in_assets && depth == 3) {
                if (k == "name") name = v
                else if (k == "size") size = v
                else if (k == "browser_download_url") url = v
                else if (k == "digest") digest = v
            }
        }
        {
            line = $0; n = length(line)
            for (i = 1; i <= n; i++) {
                c = substr(line, i, 1)
                if (instr) {
                    seg = seg c
                    if (esc) esc = 0
                    else if (c == "\\") esc = 1
                    else if (c == "\"") instr = 0
                    continue
                }
                if (c == "\"") { instr = 1; seg = seg c; continue }
                if (c == "{" || c == "[") {
                    take(1); depth++
                    if (c == "[" && depth == 2) in_assets = (arrkey == "assets")
                    if (c == "{" && in_assets && depth == 3) { name = ""; size = ""; url = ""; digest = "" }
                    continue
                }
                if (c == "}" || c == "]") {
                    take(0)
                    if (c == "}" && in_assets && depth == 3 && name != "" && size != "" && url != "")
                        printf("asset\t%s\t%s\t%s\t%s\n", name, size, url, digest)
                    if (c == "]" && depth == 2) in_assets = 0
                    depth--
                    continue
                }
                if (c == ",") { take(0); continue }
                seg = seg c
            }
            seg = seg " "
        }'
}

_assets() {
    #one line per asset this machine can run: name, size, url, sha256. The last
    #is github's digest when it is a well formed one and empty otherwise: an
    #asset uploaded before github kept digests says null, and a digest in some
    #other algorithm is not one this resolver can compare
    _fields | awk -F'\t' -v arches="$(_platform)" '
        $1 == "asset" && usable($2) {
            d = tolower($5); h = ""
            if (substr(d, 1, 7) == "sha256:") {
                h = substr(d, 8)
                if (length(h) != 64 || h !~ /^[0-9a-f]+$/) h = ""
            }
            printf("%s\t%s\t%s\t%s\n", $2, $3, $4, h)
        }
        function usable(n,   lower, n_arches, a, i) {
            lower = tolower(n)
            #signatures, checksums and distribution packages are not programs
            if (lower ~ /\.(sha[0-9]*|sha[0-9]*sum|md5|asc|sig|pem|sbom|json|txt|deb|rpm|apk|pkg|msi|dmg|exe)$/) return 0
            if (lower ~ /(darwin|apple|macos|windows|freebsd|netbsd|openbsd|android)/) return 0
            #the parentheses are load bearing: awk binds ~ tighter than ==,
            #so "lower ~ /re/ == 0" matches lower against the 0 or 1 that
            #($0 ~ /re/) produced, and a file with a 1 in its name passes a
            #test it was meant to fail
            if (!(lower ~ /(linux|musl|gnu)/)) return 0
            n_arches = split(arches, a, "|")
            for (i = 1; i <= n_arches; i++) if (index(lower, tolower(a[i]))) return 1
            return 0
        }'
}

_best() {
    #musl before glibc, because a program that carries its own libc is the
    #one that will still start on a machine this resolver knows nothing about
    awk -F'\t' '
        { score = ($1 ~ /musl/) ? 0 : 1
          if (best == "" || score < best_score) { best = $0; best_score = score } }
        END { if (best != "") print best }'
}

_version_of() {
    _fields | awk -F'\t' '$1 == "tag" {print $2; exit}'
}

_format_of() {
    case "$(printf "%s\\n" "${1}" | tr 'ABCDEFGHIJKLMNOPQRSTUVWXYZ' 'abcdefghijklmnopqrstuvwxyz')" in
        *.tar.gz|*.tgz)   printf "%s\\n" "tar.gz"  ;;
        *.tar.xz|*.txz)   printf "%s\\n" "tar.xz"  ;;
        *.tar.bz2|*.tbz2) printf "%s\\n" "tar.bz2" ;;
        *.tar)            printf "%s\\n" "tar"     ;;
        *.zip)            printf "%s\\n" "zip"     ;;
        *)                printf "%s\\n" "raw"     ;;
    esac
}

case "${1}" in
    meta)
        #both spellings are fine and the channel says so itself, rather than
        #the resolver keeping a table of other people's nicknames
        printf "%s\\n" "aliases=gh"
        printf "%s\\n" "kind=artifact"
        printf "%s\\n" "confines=no"
        printf "%s\\n" "describes=self"
        exit 0
        ;;

    probe)
        [ -z "${2}" ] && exit 1
        #this channel identifies a package as owner/repo and nothing else. A
        #bare name is a question for a catalog, and inventing an owner for it
        #would be writing the package recipe this design exists to avoid
        case "${2}" in
            */*) ;;
              *) exit 1 ;;
        esac

        _fetch_release "${2}" "${3}"
        case "${?}" in
            0) ;;
            1) exit 1 ;;
            *) printf "unreachable=%s\\n" "${why}"; exit 2 ;;
        esac
        body="$(cat "${release_file}")"
        asset="$(printf "%s\\n" "${body}" | _assets | _best)"
        #nothing to serve is an answer of 1. Saying 0 with nothing to show for
        #it is how a channel that has quietly broken passes for one that works
        [ -z "${asset}" ] && exit 1

        version="$(printf "%s\\n" "${body}" | _version_of)"
        [ -z "${version}" ] && exit 1
        printf "version=%s\\n" "${version}"
        printf "bytes=%s\\n"   "$(printf "%s\\n" "${asset}" | awk -F'\t' '{print $2}')"
        #github's own digest of the asset is known right here, in the same
        #answer. A checksum the project publishes needs a download of its own,
        #so without a digest the badge stays none until locate has looked
        if ! _off "${STATIC_RUN_GITHUB_DIGEST}" && \
           [ -n "$(printf "%s\\n" "${asset}" | awk -F'\t' '{print $4}')" ]; then
            printf "badge=%s\\n" "verified"
        else
            printf "badge=%s\\n" "none"
        fi
        exit 0
        ;;

    locate)
        [ -z "${2}" ] && exit 1
        _fetch_release "${2}" "${3}"
        case "${?}" in
            0) ;;
            1) exit 1 ;;
            *) printf "unreachable=%s\\n" "${why}"; exit 2 ;;
        esac
        body="$(cat "${release_file}")"
        asset="$(printf "%s\\n" "${body}" | _assets | _best)"
        [ -z "${asset}" ] && exit 1

        name="$(printf "%s\\n" "${asset}"   | awk -F'\t' '{print $1}')"
        url="$(printf  "%s\\n" "${asset}"   | awk -F'\t' '{print $3}')"
        digest="$(printf "%s\\n" "${asset}" | awk -F'\t' '{print $4}')"

        printf "url=%s\\n"    "${url}"
        printf "format=%s\\n" "$(_format_of "${name}")"
        printf "bin=%s\\n"    "${2##*/}"

        #github keeps a sha256 of every asset it stores, and that protects
        #against exactly what a checksum published by the project protects
        #against: a download that arrived corrupt or altered. Neither stops a
        #stolen account, which uploads the binary and its checksum together,
        #and github computes the digest of whatever it was given. So the digest
        #is enough, it is asked for first, as aqua does, and it saves the
        #download of a checksum file
        if [ -n "${digest}" ] && ! _off "${STATIC_RUN_GITHUB_DIGEST}"; then
            printf "sha256=%s\\n" "${digest}"
            exit 0
        fi

        #without one, a checksum published next to the artifact is the only
        #thing left that can make the badge verified, looked for by the two
        #names projects actually use
        sums="$(printf "%s\\n" "${body}" | _fields | awk -F'\t' '
            $1 == "asset" {
                u = $4; l = tolower(u)
                if (l ~ /(checksums?\.txt|sha256sums?(\.txt)?|\.sha256)$/) print u
            }' | awk -v n="${name}" '$0 ~ n".sha256$" {print; found=1; exit} {last=$0} END {if (!found && last != "") print last}')"

        if [ -n "${sums}" ]; then
            sha="$(_retrieve "${sums}" 2>/dev/null | awk -v n="${name}" '
                NF == 1 && length($1) == 64 {print $1; exit}
                $2 ~ ("(^|/|\\*)" n "$") {print $1; exit}')"
            [ -n "${sha}" ] && printf "sha256=%s\\n" "${sha}"
        fi
        exit 0
        ;;

    *) printf "%s\\n" "usage: ${0##*/} meta|probe|locate" >&2; exit 1 ;;
esac
