#Based on the GNU shtool test suite
@begin{simple-dhcpd}
simple-dhcpd -h; test X"${?}"                = X"0"
simple-dhcpd --help; test X"${?}"            = X"0"
simple-dhcpd --cui; test X"${?}"             = X"2"
test X"$(simple-dhcpd -h | head -1)"         = X"Usage: simple-dhcpd [options]"
test X"$(simple-dhcpd --help | head -1)"     = X"Usage: simple-dhcpd [options]"
head -1 ../../tools/simple-dhcpd | grep -qx "#!/bin/sh"
head -2 ../../tools/simple-dhcpd | tail -1 | grep -q "command -v python3"
@end

