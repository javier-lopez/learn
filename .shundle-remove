#!/bin/sh
#shundle runs this from the bundle directory in the moment before it deletes
#it. Whatever this repository put outside its own tree has to come back out
#here, because in a second there will be nothing left to ask.
#
#It cannot live in the rc file as a PostInstall does: 'shundle clean' removes
#the bundles the rc file no longer mentions, so by the time it matters the line
#that would have carried the instruction is precisely the line that was
#deleted. The bundle is still on disk; the rc entry is not.

#wcd is the one command here that writes anywhere but its own $WCDHOME: it can
#put a nightly line in the crontab, and a crontab line calling a script that
#no longer exists is a mail from cron every night for as long as the machine
#lives. --no-cron takes the line out and leaves the note saying not to offer
#it again
[ -f sh/tools/wcd ] && sh sh/tools/wcd --no-cron >/dev/null 2>&1

exit 0
